[

{id:"M1",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:2,q:"A resident asks the nursing assistant to increase a medication dose because the current dose is not working. What should the nursing assistant do?",o:["Increase the dose one time","Tell the nurse about the resident's request","Ask the family to approve the change","Skip the medication until the resident feels better"],a:1,e:"CNAs do not give or adjust medications; report the request to the licensed nurse."},
{id:"M2",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:2,q:"The nurse asks a nursing assistant to perform a task the assistant has not been trained to do. What is the best response?",o:["Attempt the task slowly","Ask another resident how it is done","Refuse all remaining assignments for the shift","Explain the lack of training and ask the nurse for direction"],a:3,e:"Never perform a task outside your training; explain and ask the nurse for direction."},
{id:"M3",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:2,q:"Which document should the nursing assistant check for a resident's approved level of assistance and daily care needs?",o:["The resident's care plan","The employee handbook","The roommate's care notes","The facility menu"],a:0,e:"The care plan directs each resident's approved level of assistance and care."},
{id:"M4",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:2,q:"Before beginning personal care, the nursing assistant should first protect the resident's privacy by:",o:["asking the roommate to watch","turning off the call light","closing the door, curtain, or privacy screen","placing supplies on the floor"],a:2,e:"Provide privacy by closing the door, curtain, or screen before care."},
{id:"M5",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:2,q:"A resident refuses a scheduled shower. What should the nursing assistant do?",o:["Tell the resident the shower is required","Respect the refusal, offer an alternative, and report it to the nurse","Ask the family to force the resident to cooperate","Document that the shower was completed"],a:1,e:"Competent residents may refuse care; respect it, offer alternatives, and report."},
{id:"M6",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:2,q:"Which chart entry is objective?",o:["The resident looks terrible today","The resident seems lazy","The resident probably has an infection","A 2-centimeter red area is present on the right heel"],a:3,e:"Objective charting records observable, measurable facts."},
{id:"M7",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:2,q:"A resident says, 'My chest feels tight.' What is the best way to document the statement?",o:["Record the resident's exact words and report them promptly","Write that the resident is exaggerating","Change the wording to a medical diagnosis","Wait until the end of the week to chart it"],a:0,e:"Use the resident's exact words in quotes and report promptly — chest tightness is urgent."},
{id:"M8",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:2,q:"The nursing assistant makes an error in documentation. What should the assistant do?",o:["Erase the entry completely","Ask a coworker to sign over it","Correct it according to facility policy without hiding the original entry","Delete the entire shift's documentation"],a:2,e:"Correct errors per policy without erasing or concealing the original entry."},
{id:"M9",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:2,q:"After a resident falls, which information belongs in the medical record?",o:["A statement blaming the resident","Objective observations and the care provided","The words 'incident report completed'","An opinion about which employee caused the fall"],a:1,e:"Chart objective observations and care; never chart that an incident report was filed."},
{id:"M10",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:3,q:"Which action best protects confidential health information?",o:["Discussing the resident in an elevator","Leaving an open chart at the nurses' station","Sharing an interesting case with friends without using the room number","Discussing resident information only with authorized care-team members in a private area"],a:3,e:"Share resident information only with the authorized care team, in private."},
{id:"M11",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:3,q:"A resident's roommate asks why the resident takes a certain medication. How should the nursing assistant respond?",o:["Explain that resident health information is private","Read the medication label aloud","Give a short summary of the diagnosis","Ask the roommate to keep the information secret"],a:0,e:"Health information is private and not shared with roommates."},
{id:"M12",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:3,q:"Which social-media action is appropriate for a nursing assistant?",o:["Posting a resident photo after covering the name badge","Sharing a funny resident story without naming the facility","Keeping all resident images and information off personal social-media accounts","Sending a resident video only to close friends"],a:2,e:"Keep all resident images and information off personal social media."},
{id:"M13",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:3,q:"What is the purpose of an advance directive?",o:["To allow the CNA to make medical diagnoses","To communicate a person's health-care wishes if the person cannot speak for themselves","To replace the resident's care plan every shift","To authorize family members to ignore the resident's wishes"],a:1,e:"An advance directive states a person's care wishes if they cannot speak for themselves."},
{id:"M14",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:3,q:"A resident has a do-not-resuscitate order. What does this mean?",o:["All food and fluids must be stopped","Routine and comfort care must be withheld","The resident cannot receive treatment for pain","CPR is not started if the resident has no pulse and is not breathing"],a:3,e:"A DNR means no CPR; comfort and routine care continue."},
{id:"M15",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:3,q:"A resident has unexplained bruises and appears afraid of a caregiver. What should the nursing assistant do?",o:["Report the observations and concerns immediately according to policy","Wait until proof is available","Question the suspected caregiver in front of the resident","Promise the resident that no one else will be told"],a:0,e:"Report suspected abuse immediately; do not investigate or promise secrecy."},
{id:"M16",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:3,q:"The nursing assistant sees a coworker strike a resident. What is the priority action?",o:["Finish the current assignment before responding","Ask the resident to forget what happened","Protect the resident from further harm and summon/report to the nurse immediately","Post a warning about the coworker online"],a:2,e:"Protect the resident and report the abuse to the nurse immediately."},
{id:"M17",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:3,q:"Why is a nursing assistant called a mandated reporter?",o:["The assistant must report every private conversation","The assistant is legally required to report suspected abuse or neglect","The assistant is responsible for diagnosing abuse","The assistant may investigate suspected crimes independently"],a:1,e:"Mandated reporters are legally required to report suspected abuse or neglect."},
{id:"M18",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:3,q:"A relative takes a resident's bank card and uses it without permission. This is an example of:",o:["therapeutic communication","restorative care","informed consent","financial exploitation"],a:3,e:"Using a resident's money without permission is financial exploitation."},
{id:"M19",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:3,q:"Which situation is an example of neglect?",o:["Repeatedly leaving a dependent resident soiled for long periods","Offering two approved clothing choices","Helping a resident attend an activity","Reporting a resident's skin change"],a:0,e:"Failing to meet basic needs, like leaving a resident soiled, is neglect."},
{id:"M20",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:4,q:"A resident chooses to wear mismatched clothing. The clothing is clean and safe. What should the nursing assistant do?",o:["Replace the clothing without asking","Tell the resident the choice is unacceptable","Respect the resident's choice","Ask the roommate to choose the clothing"],a:2,e:"Respect resident choice when it is safe."},
{id:"M21",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:4,q:"Which response demonstrates active listening?",o:["Interrupting with personal advice","Maintaining attention and restating the resident's main concern","Changing the topic when the resident pauses","Finishing every sentence for the resident"],a:1,e:"Active listening means attending and restating the resident's concern."},
{id:"M22",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:4,q:"A resident with expressive aphasia has difficulty speaking. Which approach is best?",o:["Speak rapidly to save time","Pretend to understand every response","Direct all questions to the roommate","Allow time and offer a communication board or simple choices"],a:3,e:"Give time and use a communication board or simple choices for aphasia."},
{id:"M23",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:4,q:"When communicating with a resident who has hearing loss, the nursing assistant should:",o:["face the resident, reduce background noise, and speak clearly","shout directly into the resident's ear","cover the mouth while speaking","speak from behind the resident"],a:0,e:"Face the resident, cut noise, and speak clearly — don't shout."},
{id:"M24",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:4,q:"When entering the room of a resident with vision loss, the nursing assistant should:",o:["move furniture without telling the resident","touch the resident before speaking","identify themself and explain what they are doing","leave supplies in the walking path"],a:2,e:"Identify yourself and explain your actions for a resident with vision loss."},
{id:"M25",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:4,q:"A resident does not speak English well and must make an important care decision. What is the best action?",o:["Use a young child to interpret","Request a qualified interpreter according to facility policy","Skip the explanation","Ask another resident to translate private information"],a:1,e:"Use a qualified interpreter for important care decisions."},
{id:"M26",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:4,q:"A resident follows a cultural practice unfamiliar to the nursing assistant. What should the assistant do?",o:["Tell the resident to follow the assistant's beliefs","Describe the practice as strange","Ignore the resident's preferences","Ask respectful questions and support the practice when it is safe and allowed"],a:3,e:"Support safe cultural practices respectfully."},
{id:"M27",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:4,q:"A resident offers the nursing assistant an expensive gift. What is the best response?",o:["Politely decline and follow the facility's gift policy","Accept it because the resident insisted","Trade it with another employee","Hide it until the end of the shift"],a:0,e:"Decline significant gifts and follow facility policy."},
{id:"M28",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:4,q:"A concern reported to the charge nurse is not addressed and the resident remains at risk. What should the nursing assistant do next?",o:["Stop reporting the concern","Discuss the concern with visitors","Continue up the chain of command according to policy","Change the care plan independently"],a:2,e:"Escalate unresolved safety concerns up the chain of command."},
{id:"M29",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:5,q:"The nursing assistant does not understand a delegated task. What should the assistant do before beginning?",o:["Guess based on a similar task","Ask the nurse to clarify the task and expected observations","Ask the resident to direct the procedure","Document the task before doing it"],a:1,e:"Clarify unclear delegated tasks with the nurse before starting."},
{id:"M30",bank:"MASSIVE",type:"mc",sub:"Role, Rights, Communication & Law",pg:5,q:"A resident is suddenly struggling to breathe while asking for help finding a television program. Which need has priority?",o:["Finding the television program","Choosing tomorrow's clothing","Completing the activity calendar","Supporting breathing and getting immediate help"],a:3,e:"Breathing (airway) is the top priority — get help immediately."},

{id:"M31",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:5,q:"When should a nursing assistant perform hand hygiene?",o:["Before and after resident contact and whenever indicated by infection-control policy","Only when hands look dirty","Only at the beginning of the shift","Only after removing a gown"],a:0,e:"Perform hand hygiene before/after contact and whenever policy indicates."},
{id:"M32",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:5,q:"What should the nursing assistant do immediately after removing gloves?",o:["Touch the face shield","Reuse the gloves for the same resident","Perform hand hygiene","Write notes before washing"],a:2,e:"Always perform hand hygiene right after removing gloves."},
{id:"M33",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:5,q:"Standard precautions are used:",o:["only with residents known to have HIV","with every resident, regardless of diagnosis","only during isolation","only when a family member requests them"],a:1,e:"Standard precautions apply to every resident."},
{id:"M34",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:5,q:"Which action most directly breaks the chain of infection at the mode-of-transmission link?",o:["Closing the resident's blinds","Raising the bed","Offering a newspaper","Performing correct hand hygiene"],a:3,e:"Hand hygiene breaks the mode-of-transmission link."},
{id:"M35",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:5,q:"Before entering a room with a transmission-based precautions sign, the nursing assistant should:",o:["read the sign and apply the required personal protective equipment","enter first and read the sign later","remove all protective equipment","ask the roommate whether precautions are necessary"],a:0,e:"Read the sign and apply the required PPE before entering."},
{id:"M36",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:5,q:"When gown, mask, eye protection, and gloves are required, which item is generally put on last?",o:["Gown","Mask","Gloves","Eye protection"],a:2,e:"Gloves go on last when donning PPE."},
{id:"M37",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:5,q:"Which part of a used glove is considered contaminated?",o:["Only the cuff","The outside surface","Only the inside surface","The unopened glove box"],a:1,e:"The outside surface of a used glove is contaminated."},
{id:"M38",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:6,q:"How should soiled linen be handled?",o:["Shake it to remove crumbs","Place it on the floor temporarily","Carry it against the chest","Hold it away from the uniform and place it directly in the designated container"],a:3,e:"Keep soiled linen off your uniform and the floor; never shake it."},
{id:"M39",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:6,q:"A blood spill is found on the floor. What should the nursing assistant do?",o:["Keep others away and clean or report it according to the blood-spill policy using proper PPE","Wipe it with a dry paper towel using bare hands","Cover it with clean linen","Leave it for the next shift"],a:0,e:"Follow the blood-spill policy with proper PPE."},
{id:"M40",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:6,q:"The nursing assistant is accidentally stuck by a used sharp. What should the assistant do?",o:["Hide the injury to avoid paperwork","Squeeze the wound into a resident's sink and continue working","Wash the area and report the exposure immediately according to policy","Wait for symptoms before reporting"],a:2,e:"Wash and report a sharps exposure immediately."},
{id:"M41",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:6,q:"A resident has suspected Clostridioides difficile diarrhea. Which hand-hygiene method is especially important after care?",o:["Rinsing with water only","Washing with soap and water as directed by policy","Wiping hands on a towel","Wearing two pairs of gloves instead of washing"],a:1,e:"For C. difficile, wash with soap and water (sanitizer is not enough)."},
{id:"M42",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:6,q:"Which observation may indicate a urinary tract infection in an older adult?",o:["Improved appetite","Clear speech after exercise","Stronger fingernails","New confusion with urinary urgency or foul-smelling urine"],a:3,e:"New confusion with urgency or foul-smelling urine can signal a UTI."},
{id:"M43",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:6,q:"Which finding should be reported as a possible respiratory infection?",o:["New cough, fever, or difficulty breathing","A preference for warm blankets","A request for a later breakfast","Gray hair"],a:0,e:"New cough, fever, or breathing trouble may indicate respiratory infection."},
{id:"M44",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:6,q:"Reusable resident-care equipment should be:",o:["stored without cleaning if it looks dry","shared while still wet from use","cleaned and disinfected according to policy between residents","cleaned only once each month"],a:2,e:"Clean and disinfect reusable equipment between residents."},
{id:"M45",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:6,q:"Medical asepsis means:",o:["destroying every microorganism by surgery","reducing the number and spread of disease-causing microorganisms","keeping a resident completely isolated","using medication to treat all infections"],a:1,e:"Medical asepsis reduces the number and spread of microorganisms."},
{id:"M46",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:6,q:"Which body-mechanics action is safest when lifting or moving an object?",o:["Twist at the waist while lifting","Keep the knees locked","Hold the object away from the body","Keep the object close, bend the knees, and use the leg muscles"],a:3,e:"Keep the load close, bend the knees, and lift with the legs."},
{id:"M47",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:6,q:"Before using a transfer belt, the nursing assistant should:",o:["check the care plan and inspect the belt and resident for contraindications","place it over feeding tubes","apply it directly over bare skin","assume every resident can use one"],a:0,e:"Check the care plan and inspect for contraindications before using a transfer belt."},
{id:"M48",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:7,q:"When helping a resident with one-sided weakness walk, the nursing assistant generally stays:",o:["several feet in front","only on the strong side","on the resident's weak side and slightly behind","behind the wheelchair across the room"],a:2,e:"Stay on the weak side, slightly behind, to support and guard."},
{id:"M49",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:7,q:"Before leaving a resident in bed, the nursing assistant should make sure the bed is:",o:["high and unlocked","low and locked with the call light within reach","high with the call light on the floor","unlocked so it can move during a fall"],a:1,e:"Leave the bed low and locked with the call light in reach."},
{id:"M50",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:7,q:"A resident is found on the floor after an unwitnessed fall. What should the nursing assistant do first?",o:["Lift the resident into bed alone","Ask the resident to walk immediately","Complete documentation before calling anyone","Stay with the resident, call the nurse, and avoid moving the resident unless there is immediate danger"],a:3,e:"Stay, call the nurse, and don't move the resident until assessed."},
{id:"M51",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:7,q:"A conscious adult is choking and cannot speak or cough. What should a trained nursing assistant do?",o:["Activate the emergency response and provide appropriate choking care","Give the resident water","Leave the resident alone to find food","Place food deeper into the mouth"],a:0,e:"Activate emergency response and give trained choking care."},
{id:"M52",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:7,q:"In the fire-response acronym RACE, the letter R means:",o:["Return to the break room","Record the temperature","Rescue or remove anyone in immediate danger","Replace the extinguisher"],a:2,e:"R = Rescue/remove anyone in immediate danger."},
{id:"M53",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:7,q:"In the fire-extinguisher acronym PASS, the first S means:",o:["Stand behind the fire","Squeeze the handle","Shut off every call light","Signal the resident to leave alone"],a:1,e:"PASS: Pull, Aim, Squeeze, Sweep — the first S is Squeeze."},
{id:"M54",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:7,q:"During a seizure, the nursing assistant should:",o:["force an object into the resident's mouth","hold the arms and legs down","give food during the seizure","protect the resident from injury and clear nearby hazards"],a:3,e:"Protect from injury and clear hazards; never restrain or put anything in the mouth."},
{id:"M55",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:7,q:"Which action is safest around oxygen equipment?",o:["Keep flames, sparks, and smoking materials away","Use petroleum jelly near the nose","Store oxygen beside a space heater","Change the flow rate without an order"],a:0,e:"Keep flames and sparks away from oxygen."},
{id:"M56",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:7,q:"An electrical cord is frayed. What should the nursing assistant do?",o:["Wrap it with a wet towel","Use it only for a short task","Remove the equipment from use and report it according to policy","Place it under a rug"],a:2,e:"Take frayed equipment out of use and report it."},
{id:"M57",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:7,q:"Before placing a resident in bath water, the nursing assistant should:",o:["use the hottest water available","check the water temperature and have the resident verify comfort when able","test the water only after the resident enters","leave the resident alone while the tub fills"],a:1,e:"Check water temperature and confirm comfort before the bath."},
{id:"M58",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:8,q:"A restraint may be used only when:",o:["the unit is short-staffed","the resident calls frequently","a visitor asks for it","it is properly authorized, in the care plan, and used according to law and policy"],a:3,e:"Restraints require proper authorization, care plan, and legal/policy compliance."},
{id:"M59",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:8,q:"Elopement occurs when:",o:["a resident who cannot protect themself leaves a safe area unnoticed and unsupervised","a resident attends a scheduled activity","a resident transfers to another unit with staff","a competent resident signs out according to policy"],a:0,e:"Elopement is an at-risk resident leaving a safe area unnoticed."},
{id:"M60",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:8,q:"A resident who wanders is approaching an unsafe exit. What should the nursing assistant do?",o:["shout at the resident","lock the resident alone in a room","Redirect the resident calmly and follow the elopement-prevention plan","ignore the behavior until the resident leaves"],a:2,e:"Calmly redirect and follow the elopement-prevention plan."},
{id:"M61",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:8,q:"During a facility disaster, the nursing assistant should:",o:["leave without telling anyone","follow the facility emergency plan and instructions from the person in charge","create a personal evacuation route for residents","use elevators during a fire unless told otherwise"],a:1,e:"Follow the facility emergency plan and the person in charge."},
{id:"M62",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:8,q:"A resident is unresponsive and not breathing normally. What should a trained nursing assistant do?",o:["Wait ten minutes for the nurse","Give food and water","Place the resident in a bathtub","Call for emergency help and begin CPR according to training and facility policy"],a:3,e:"Call for help and begin CPR per training and policy."},
{id:"M63",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:8,q:"A resident may have swallowed a harmful chemical. What should the nursing assistant do?",o:["Call for the nurse or emergency help and follow poison-response directions","Make the resident vomit without instructions","Give milk automatically","Hide the container"],a:0,e:"Get help and follow poison-response directions; keep the container."},
{id:"M64",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:8,q:"Which action best reduces fall risk in a resident's room?",o:["Leave cords across the walkway","Keep the floor wet","Keep pathways clear and frequently used items within reach","Move the call light out of reach"],a:2,e:"Clear pathways and keep needed items and the call light in reach."},
{id:"M65",bank:"MASSIVE",type:"mc",sub:"Infection Control, Safety & Emergencies",pg:8,q:"The nursing assistant notices water leaking onto a hallway floor. What should the assistant do?",o:["Walk away because housekeeping owns the task","Guard the area and arrange immediate cleanup according to policy","Cover the water with paper and leave","Wait until someone slips before reporting it"],a:1,e:"Guard the wet area and arrange immediate cleanup."},

{id:"M66",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:9,q:"When measuring a radial pulse, the nursing assistant should use:",o:["the thumb","the palm of the hand","the fingernails","the pads of two or three fingers"],a:3,e:"Use the finger pads (not the thumb) to feel a radial pulse."},
{id:"M67",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:9,q:"For the most accurate respiratory rate, the nursing assistant should:",o:["observe the chest or abdomen without drawing attention to the counting","tell the resident to breathe as fast as possible","count only after exercise","ask the roommate to estimate it"],a:0,e:"Count respirations discreetly so the resident doesn't alter breathing."},
{id:"M68",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:9,q:"A blood-pressure cuff that is too small may produce a reading that is:",o:["always exactly correct","falsely low in every case","falsely high","the same as a pulse reading"],a:2,e:"A too-small cuff gives a falsely high reading."},
{id:"M69",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:9,q:"The systolic blood pressure is the pressure:",o:["when the heart rests between beats","when the heart contracts","inside the lungs during exhalation","in the veins when standing"],a:1,e:"Systolic pressure occurs when the heart contracts."},
{id:"M70",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:9,q:"The diastolic blood pressure is the pressure:",o:["when the heart contracts","only during exercise","inside the stomach after eating","when the heart relaxes between beats"],a:3,e:"Diastolic pressure occurs when the heart relaxes between beats."},
{id:"M71",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:9,q:"A vital-sign result is far outside the resident's usual range. What should the nursing assistant do?",o:["Recheck as appropriate and report promptly to the nurse","Change the number to match the usual range","Wait several days to see if it happens again","Ask the family to diagnose the cause"],a:0,e:"Recheck if appropriate and report abnormal vitals promptly."},
{id:"M72",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:9,q:"A resident becomes dizzy when standing. What is the safest immediate action?",o:["Encourage the resident to keep walking","Leave to find the chart","Help the resident sit or lie down and report the change","Ask the resident to stand without support"],a:2,e:"Help the resident sit/lie down and report the dizziness."},
{id:"M73",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:9,q:"A resident reports new chest pressure and shortness of breath. What should the nursing assistant do?",o:["Finish the bath first","Stop the activity, stay with the resident, and get the nurse or emergency help immediately","Offer a large meal","Tell the resident to wait until the next shift"],a:1,e:"Chest pressure with shortness of breath is an emergency — get help now."},
{id:"M74",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:9,q:"Which finding is included in the FAST warning signs for stroke?",o:["Gradual hair growth","Itching after a bath","A long-standing preference for soft food","Facial drooping or arm weakness with speech difficulty"],a:3,e:"FAST = Face drooping, Arm weakness, Speech difficulty, Time to call."},
{id:"M75",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:10,q:"Which group of findings may indicate low blood sugar?",o:["Shakiness, sweating, confusion, or weakness","Slow nail growth and dry hair","Increased height and clearer vision","Warm hands after a shower"],a:0,e:"Shakiness, sweating, and confusion can signal low blood sugar."},
{id:"M76",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:10,q:"Which observation may be associated with high blood sugar?",o:["Decreased thirst and no urine","Sudden hearing improvement","Increased thirst and frequent urination","A lower shoe size"],a:2,e:"Increased thirst and frequent urination can indicate high blood sugar."},
{id:"M77",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:10,q:"Edema means:",o:["a break in a bone","swelling caused by fluid in the tissues","loss of hearing","difficulty swallowing"],a:1,e:"Edema is swelling from fluid in the tissues."},
{id:"M78",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:10,q:"Cyanosis is best described as:",o:["a yellow bruise that is healing","normal redness after rubbing","dark hair at the scalp","a bluish or grayish color of the skin, lips, or nail beds"],a:3,e:"Cyanosis is a bluish/grayish color of skin, lips, or nail beds."},
{id:"M79",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:10,q:"Which skin finding may be an early pressure injury and should be reported?",o:["Persistent red, purple, or dark discoloration over a pressure area","Temporary lines from loose clothing","Freckles present for many years","A healed scar with no change"],a:0,e:"Persistent discoloration over a pressure area may be an early pressure injury."},
{id:"M80",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:10,q:"Which action helps prevent shearing of a resident's skin?",o:["Pull the resident by the arms","Raise the head of the bed as high as possible at all times","Use a lift sheet or approved device rather than dragging the resident","Slide the resident across dry sheets"],a:2,e:"Use a lift sheet instead of dragging to prevent shearing."},
{id:"M81",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:10,q:"How often should an immobile resident be repositioned?",o:["Only once each shift","According to the individualized care plan and whenever needed","Only when the resident asks","Exactly once every eight hours for every resident"],a:1,e:"Reposition per the care plan and whenever needed."},
{id:"M82",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:10,q:"For the most comparable daily weights, the nursing assistant should weigh the resident:",o:["on a different scale each time","immediately after a large meal one day and before breakfast the next","while the resident holds different objects","at about the same time, in similar clothing, using the same scale when possible"],a:3,e:"Weigh at the same time, in similar clothing, on the same scale."},
{id:"M83",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:10,q:"A resident drinks 240 mL of milk, 120 mL of juice, and 90 mL of water. What total intake should be recorded?",o:["450 mL","330 mL","360 mL","540 mL"],a:0,e:"240 + 120 + 90 = 450 mL."},
{id:"M84",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:10,q:"Eight fluid ounces is approximately equal to:",o:["30 mL","60 mL","240 mL","480 mL"],a:2,e:"8 oz ≈ 240 mL (1 oz ≈ 30 mL)."},
{id:"M85",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:11,q:"Four fluid ounces is approximately equal to:",o:["30 mL","120 mL","240 mL","360 mL"],a:1,e:"4 oz ≈ 120 mL."},
{id:"M86",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:11,q:"Which item is recorded as output?",o:["Water used for a bed bath","Soup served on the meal tray","Ice left in a pitcher","Urine emptied from a catheter drainage bag"],a:3,e:"Urine output (from the drainage bag) is recorded as output."},
{id:"M87",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:11,q:"When collecting a urine specimen, the nursing assistant should:",o:["use the correct container, avoid contamination, label it, and transport it according to policy","leave it unlabeled in the bathroom","pour it into a drinking cup","mix it with toilet water"],a:0,e:"Use the correct labeled container and avoid contamination."},
{id:"M88",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:11,q:"Where should a urinary drainage bag be positioned?",o:["On the resident's abdomen","Above the bladder","Below the level of the bladder and off the floor","On the floor under the bed"],a:2,e:"Keep the drainage bag below the bladder and off the floor."},
{id:"M89",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:11,q:"What should the nursing assistant do if catheter tubing is kinked?",o:["Cut the tubing","Straighten the tubing without pulling and make sure urine can flow","Raise the bag above the bladder","Disconnect the closed system routinely"],a:1,e:"Straighten kinked tubing without pulling and keep urine flowing."},
{id:"M90",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:11,q:"Which urine observation should be reported?",o:["The amount ordered in the care plan","A labeled specimen cup","Clear tubing without kinks","New blood, cloudiness, strong odor, pain, or major change in amount"],a:3,e:"Report blood, cloudiness, odor, pain, or a major change in urine."},
{id:"M91",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:11,q:"Which stool finding requires prompt reporting?",o:["Black, tarry stool or visible blood","A formed brown stool","A bowel movement at the resident's usual time","Stool recorded according to policy"],a:0,e:"Black, tarry, or bloody stool needs prompt reporting."},
{id:"M92",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:11,q:"A resident begins vomiting while lying flat. What should the nursing assistant do first?",o:["Offer solid food","Leave the resident flat and unattended","Turn the resident to the side or raise the upper body to protect the airway and call for help","Ask the resident to hold the vomit in the mouth"],a:2,e:"Turn to the side to protect the airway, then get help."},
{id:"M93",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:11,q:"A resident reports pain rated 8 out of 10. What is the nursing assistant's responsibility?",o:["Diagnose the cause","Report the pain promptly and document observations according to policy","Change the pain-medication dose","Tell the resident pain is expected"],a:1,e:"Report and document pain; the nurse manages treatment."},
{id:"M94",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:11,q:"A pulse oximeter measures:",o:["blood glucose","urine concentration","hearing ability","the percentage of hemoglobin carrying oxygen"],a:3,e:"A pulse oximeter measures oxygen saturation of the blood."},
{id:"M95",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:12,q:"The nursing assistant notes an irregular pulse. What should the assistant do?",o:["Count for the full required time and report the irregularity","Record it as regular","Stop counting after ten seconds","Ask the resident to choose a number"],a:0,e:"Count the full time and report an irregular pulse."},
{id:"M96",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:12,q:"Which breathing change should be reported immediately?",o:["Quiet breathing during sleep","A normal breath after laughing","New labored breathing, gasping, or inability to speak normally","A resident asking to open the blinds"],a:2,e:"New labored breathing or gasping is an emergency to report."},
{id:"M97",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:12,q:"A temperature taken immediately after a hot drink may be inaccurate if measured by which route?",o:["Axillary","Oral","Tympanic","Temporal"],a:1,e:"A hot drink affects an oral temperature reading."},
{id:"M98",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:12,q:"A resident's normal baseline is important because it helps the care team:",o:["ignore abnormal findings","replace all provider orders","predict every future illness","recognize meaningful changes in the resident's condition"],a:3,e:"A baseline helps the team recognize meaningful changes."},
{id:"M99",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:12,q:"When should intake and output be recorded?",o:["As soon as possible after measuring or observing it","From memory at the end of the month","Before the resident consumes anything","Only when the amount is abnormal"],a:0,e:"Record I&O as soon as possible after measuring."},
{id:"M100",bank:"MASSIVE",type:"mc",sub:"Basic Nursing Skills, Vitals & Reporting",pg:12,q:"Which documentation practice is correct?",o:["Copy the previous shift's entries","Use unapproved abbreviations","Chart only care personally provided or directly observed, using approved terms","Record care before performing it"],a:2,e:"Chart only what you did or observed, using approved terms."},

{id:"M101",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:12,q:"Before beginning a bath, the nursing assistant should:",o:["leave the resident exposed while collecting supplies","gather supplies, provide privacy, explain the care, and check water temperature","fill the basin with very hot water","begin without asking permission"],a:1,e:"Gather supplies, give privacy, explain, and check water temperature first."},
{id:"M102",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:12,q:"During personal care, the resident should be uncovered:",o:["from shoulders to feet for the entire procedure","only when the room door is open","whenever visitors are present","only in the area being washed or cared for"],a:3,e:"Expose only the area being cared for."},
{id:"M103",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:12,q:"During a bed bath, which area is generally washed first?",o:["The cleaner areas such as the eyes and face","The perineal area","The buttocks","The feet after walking barefoot"],a:0,e:"Wash cleaner areas (eyes/face) first, moving to dirtier areas."},
{id:"M104",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:13,q:"When providing perineal care to a female resident, the nursing assistant cleans:",o:["from back to front","in random circles with the same area of cloth","from front to back, using a clean area of the cloth for each stroke","only with dry tissue"],a:2,e:"Clean front to back with a clean cloth area each stroke."},
{id:"M105",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:13,q:"After cleaning an uncircumcised male resident, the nursing assistant must:",o:["leave the foreskin retracted","return the foreskin to its natural position","apply powder under the foreskin","pull on the catheter tubing"],a:1,e:"Return the foreskin to its natural position after care."},
{id:"M106",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:13,q:"For oral care of an unconscious resident, the safest position is generally:",o:["flat on the back with large amounts of water","standing at the sink","prone with the face in a pillow","side-lying with the head turned to allow drainage"],a:3,e:"Side-lying with head turned lets fluid drain and protects the airway."},
{id:"M107",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:13,q:"How should dentures be handled during cleaning?",o:["Over a lined sink or basin using cool or lukewarm water","Over an empty hard sink using hot water","With bleach unless the resident requests it","Wrapped in dry tissue on the meal tray"],a:0,e:"Clean dentures over a lined sink with cool/lukewarm water."},
{id:"M108",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:13,q:"A resident has diabetes and needs toenail care. What should the nursing assistant do?",o:["Cut the nails deeply at the corners","Soak the feet in very hot water","Follow the care plan and facility policy, reporting concerns rather than cutting nails unless specifically authorized","Remove calluses with a sharp tool"],a:2,e:"Don't cut a diabetic resident's nails unless authorized; report concerns."},
{id:"M109",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:13,q:"A resident takes an anticoagulant and needs shaving. Which action is safest?",o:["Use a straight razor","Use an electric razor if allowed by the care plan","Dry-shave quickly with a dull blade","Skip reporting any cuts"],a:1,e:"Use an electric razor for residents on anticoagulants (bleeding risk)."},
{id:"M110",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:13,q:"When dressing a resident with right-sided weakness, which arm goes into the shirt first?",o:["The left arm","Both arms at the same time","Whichever arm the nursing assistant prefers","The right arm"],a:3,e:"Dress the weak (right) side first."},
{id:"M111",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:13,q:"When undressing a resident with left-sided weakness, which side is generally removed first?",o:["The strong right side","The weak left side","Both sides by pulling the garment over the head","The side with the most pain"],a:0,e:"Undress the strong side first, then the weak side."},
{id:"M112",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:13,q:"A red area is seen over the resident's tailbone. What should the nursing assistant do?",o:["Massage the area firmly","Apply heat without an order","Relieve pressure and report the finding without massaging the area","Ignore it until the skin opens"],a:2,e:"Relieve pressure and report; never massage a reddened area."},
{id:"M113",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:13,q:"What is the safest position for a resident who is eating?",o:["Flat on the back","Upright as directed by the care plan","With the chin tilted far backward","Lying face down"],a:1,e:"Upright positioning reduces aspiration risk while eating."},
{id:"M114",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:14,q:"Which finding may indicate difficulty swallowing?",o:["Chewing thoroughly","Requesting a napkin","Choosing a favorite approved food","Coughing, choking, a wet voice, or pocketing food"],a:3,e:"Coughing, choking, wet voice, or pocketing food signal swallowing trouble."},
{id:"M115",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:14,q:"A resident begins coughing and has a wet-sounding voice while eating. What should the nursing assistant do?",o:["Stop feeding, keep the resident upright, and notify the nurse","Give a larger bite","Lay the resident flat","Tell the resident to eat faster"],a:0,e:"Stop feeding, keep upright, and notify the nurse."},
{id:"M116",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:14,q:"A resident is ordered thickened liquids. The nursing assistant should:",o:["thin the liquids if the resident dislikes them","replace them with regular water","serve liquids at the ordered consistency and report any swallowing problems","change the order independently"],a:2,e:"Serve the ordered consistency and report swallowing problems."},
{id:"M117",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:14,q:"What does NPO mean?",o:["Normal portions offered","Nothing by mouth","No physical observations","Nutrition provided orally"],a:1,e:"NPO means nothing by mouth."},
{id:"M118",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:14,q:"How should the nursing assistant verify a resident's diet before serving a meal?",o:["Ask the roommate","Choose a diet based on appearance","Serve the same diet to everyone","Check the current diet order or care plan and follow facility procedure"],a:3,e:"Verify the diet order/care plan before serving."},
{id:"M119",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:14,q:"A resident can eat independently using an adaptive utensil but needs extra time. What should the nursing assistant do?",o:["Set up the meal and encourage the resident to do as much as possible","Feed the resident quickly","Remove the adaptive utensil","Tell the resident independence is unsafe"],a:0,e:"Support independence — set up and encourage self-feeding."},
{id:"M120",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:14,q:"When assisting a resident to eat, the nursing assistant should:",o:["mix all foods together without asking","give the next bite before the resident swallows","offer small bites at a safe pace and allow time to chew and swallow","stand over the resident and rush the meal"],a:2,e:"Offer small bites at a safe pace; let the resident swallow."},
{id:"M121",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:14,q:"A resident refuses the prescribed meal. What should the nursing assistant do?",o:["Force the resident to eat","Respect the refusal, offer approved alternatives if available, and report/document it","Change the diet order","Hide the tray and chart full intake"],a:1,e:"Respect the refusal, offer alternatives, and report/document."},
{id:"M122",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:14,q:"Which finding may indicate dehydration?",o:["Moist mouth and pale urine","Stable weight and normal intake","Improved skin condition","Dry mouth, concentrated urine, dizziness, or new confusion"],a:3,e:"Dry mouth, dark urine, dizziness, or confusion suggest dehydration."},
{id:"M123",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:14,q:"A resident has a fluid restriction. What is the nursing assistant's responsibility?",o:["Track and offer fluids within the ordered limit and report concerns","Ignore fluids in soup and gelatin","Give unlimited water at night","Cancel the restriction when the resident is thirsty"],a:0,e:"Track fluids within the ordered limit and report concerns."},
{id:"M124",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:15,q:"Which item normally counts as fluid intake?",o:["Toast","Scrambled eggs","Soup that is liquid at room temperature","A dry sandwich"],a:2,e:"Foods liquid at room temperature (soup, gelatin) count as fluid."},
{id:"M125",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:15,q:"Before placing a resident on a bedpan, the nursing assistant should:",o:["place the bedpan on a wet surface","provide privacy, explain the procedure, and position the resident safely","leave the bed high and unlocked","tell the resident to wait indefinitely"],a:1,e:"Give privacy, explain, and position safely before the bedpan."},
{id:"M126",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:15,q:"Which action supports dignity during toileting?",o:["Discuss the resident's bowel habits in the hallway","Leave the resident exposed","Rush the resident without explanation","Close the curtain or door and provide only the assistance needed"],a:3,e:"Provide privacy and only needed assistance to preserve dignity."},
{id:"M127",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:15,q:"Which action may help prevent constipation when allowed by the care plan?",o:["Encourage fluids, fiber, activity, and a regular toileting routine","Limit all movement","Ignore the urge to defecate","Provide only low-fiber foods"],a:0,e:"Fluids, fiber, activity, and routine help prevent constipation."},
{id:"M128",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:15,q:"A resident develops frequent watery stools. What should the nursing assistant do?",o:["Give an antidiarrheal medication independently","Stop all fluids","Provide skin care, use infection precautions, record the stools, and report the change","Wait several days before reporting"],a:2,e:"Give skin care, use precautions, record, and report diarrhea."},
{id:"M129",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:15,q:"After an incontinent episode, the nursing assistant should:",o:["leave the wet brief in place","clean and dry the skin promptly and apply products according to the care plan","scrub the skin harshly","use powder without checking the care plan"],a:1,e:"Clean and dry the skin promptly and follow the care plan."},
{id:"M130",bank:"MASSIVE",type:"mc",sub:"Personal Care, Nutrition & Elimination",pg:15,q:"When emptying an ostomy pouch, the nursing assistant should:",o:["pull the stoma to inspect it","discard output without recording when measurement is ordered","share observations with visitors","wear gloves, measure or observe output as ordered, and protect the resident's privacy"],a:3,e:"Glove, measure/observe output as ordered, and protect privacy."},

{id:"M131",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:15,q:"During range-of-motion exercises, the resident reports sharp pain. What should the nursing assistant do?",o:["Stop the movement and report the pain","Force the joint through the full range","Increase the speed","Tell the resident pain is required for progress"],a:0,e:"Stop ROM and report pain."},
{id:"M132",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:15,q:"Active range-of-motion exercise is performed:",o:["entirely by the nursing assistant","only while the resident sleeps","by the resident using their own muscle strength","with a restraint holding the joint"],a:2,e:"Active ROM is done by the resident's own muscles."},
{id:"M133",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:16,q:"Passive range-of-motion exercise is performed when:",o:["the resident moves without help","the caregiver moves the joint because the resident cannot complete the movement independently","the resident walks with a cane","the resident refuses all movement"],a:1,e:"Passive ROM: the caregiver moves the joint for the resident."},
{id:"M134",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:16,q:"On which side should a resident generally hold a cane?",o:["The weaker side","Either side regardless of the care plan","Behind the back","The stronger side"],a:3,e:"Hold the cane on the stronger side."},
{id:"M135",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:16,q:"Which sequence is commonly used when walking with a walker and one weak leg?",o:["Move the walker, then the weak leg, then the strong leg","Move the strong leg, discard the walker, then move the weak leg","Move both legs before the walker","Pull the walker behind the body"],a:0,e:"Walker first, then weak leg, then strong leg."},
{id:"M136",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:16,q:"Before transferring a resident into or out of a wheelchair, the nursing assistant should:",o:["remove the brakes","leave the wheelchair moving","lock the wheelchair brakes","place the wheelchair far from the resident"],a:2,e:"Lock the wheelchair brakes before a transfer."},
{id:"M137",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:16,q:"Before helping a resident stand from a wheelchair, the nursing assistant should usually:",o:["leave both feet on the footrests","move or swing the footrests out of the way","pull the resident by the neck","unlock the wheels"],a:1,e:"Swing the footrests out of the way before standing."},
{id:"M138",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:16,q:"A contracture is:",o:["temporary hunger before a meal","a normal change in hair color","a type of hearing aid","permanent tightening or shortening of muscles, tendons, or joints"],a:3,e:"A contracture is permanent tightening/shortening of muscle or joint."},
{id:"M139",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:16,q:"Which action best promotes a resident's independence?",o:["Allowing the resident time to complete safe parts of care","Doing every task even when the resident can participate","Removing adaptive devices","Making all choices for the resident"],a:0,e:"Let the resident safely do what they can."},
{id:"M140",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:16,q:"A resident with dementia says, 'I need to go home to my mother.' What is the best response?",o:["Argue that the resident's mother is dead","Tell the resident to stop talking","Acknowledge the feeling and gently redirect to a comforting topic or activity","Ignore the resident's distress"],a:2,e:"Acknowledge the feeling and gently redirect."},
{id:"M141",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:16,q:"A resident with dementia becomes agitated during a bath. What should the nursing assistant do first?",o:["Continue quickly despite resistance","Pause, reduce stimulation, reassure the resident, and look for the cause","Shout instructions","Invite several employees to watch"],a:1,e:"Pause, reduce stimulation, reassure, and look for the cause."},
{id:"M142",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:16,q:"A resident says there are insects on the wall, but none are present. What is the best response?",o:["Agree that the insects are real","Laugh at the resident","Argue until the resident admits being wrong","Acknowledge the resident's fear, offer reassurance, and report the hallucination"],a:3,e:"Acknowledge the fear, reassure, and report the hallucination."},
{id:"M143",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:17,q:"A normally alert resident suddenly becomes confused and restless. What should the nursing assistant do?",o:["Report the sudden change immediately because it may be delirium or illness","Assume it is normal aging","Wait several weeks","Restrain the resident without an order"],a:0,e:"Report sudden confusion — it may be delirium or illness."},
{id:"M144",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:17,q:"Sundowning refers to:",o:["improved hearing at noon","a skin reaction to soap","increased confusion or agitation later in the day","a required afternoon nap"],a:2,e:"Sundowning is increased confusion/agitation later in the day."},
{id:"M145",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:17,q:"A resident says, 'I do not want to live anymore.' What should the nursing assistant do?",o:["Promise to keep it secret","Stay with the resident and report the statement immediately","Tell the resident to cheer up","Leave the resident alone to rest"],a:1,e:"Stay with the resident and report the statement immediately."},
{id:"M146",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:17,q:"When caring for a person with a developmental disability, the nursing assistant should:",o:["speak only to the family","assume the person cannot learn","use childish language with every adult","speak directly to the person and support abilities and choices"],a:3,e:"Speak directly to the person and support their abilities and choices."},
{id:"M147",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:17,q:"Which statement about mental illness is correct?",o:["A person with mental illness deserves the same dignity, rights, and individualized care as every resident","Mental illness is a character flaw","All people with mental illness are dangerous","Symptoms should be ignored"],a:0,e:"People with mental illness deserve the same dignity and rights."},
{id:"M148",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:17,q:"A resident is grieving the death of a spouse. Which response is most therapeutic?",o:["Tell the resident to move on","Change the subject whenever the spouse is mentioned","Listen, allow expression of feelings, and offer support","Compare the loss with the nursing assistant's problems"],a:2,e:"Listen and allow the resident to express grief."},
{id:"M149",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:17,q:"What is the main focus of palliative or hospice care?",o:["Curing every disease at any cost","Comfort, quality of life, dignity, and support for the resident and family","Stopping all personal care","Preventing family visits"],a:1,e:"Palliative/hospice care focuses on comfort, dignity, and support."},
{id:"M150",bank:"MASSIVE",type:"mc",sub:"Restorative, Dementia & End-of-Life",pg:17,q:"An end-of-life resident has a dry mouth and cannot drink much. What care is appropriate?",o:["Force large amounts of fluid","Stop all oral hygiene","Use alcohol-based mouthwash repeatedly","Provide frequent gentle mouth care according to the care plan"],a:3,e:"Give frequent gentle mouth care for comfort."},

{id:"M151",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"Standard precautions are used when caring for every resident.",o:["True","False"],a:0,e:"True — standard precautions apply to every resident."},
{id:"M152",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"Wearing gloves replaces the need for hand hygiene.",o:["True","False"],a:1,e:"False — gloves never replace hand hygiene."},
{id:"M153",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"A resident who can make decisions has the right to refuse care.",o:["True","False"],a:0,e:"True — competent residents may refuse care."},
{id:"M154",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"A nursing assistant may independently change a resident's diet order.",o:["True","False"],a:1,e:"False — only the provider/nurse changes diet orders."},
{id:"M155",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"Using a resident's exact words in quotation marks can be objective documentation.",o:["True","False"],a:0,e:"True — direct quotes are objective."},
{id:"M156",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"The medical record should state that an incident report was completed.",o:["True","False"],a:1,e:"False — never chart that an incident report was filed."},
{id:"M157",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"It is acceptable to leave the call light out of reach if the resident uses it frequently.",o:["True","False"],a:1,e:"False — the call light must always be within reach."},
{id:"M158",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"Repositioning according to the care plan can help prevent pressure injuries.",o:["True","False"],a:0,e:"True — repositioning helps prevent pressure injuries."},
{id:"M159",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"A reddened bony area should be massaged firmly.",o:["True","False"],a:1,e:"False — never massage a reddened bony area."},
{id:"M160",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"The bed should generally be low and locked before the nursing assistant leaves the room.",o:["True","False"],a:0,e:"True — leave the bed low and locked."},
{id:"M161",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"Female perineal care is performed from back to front.",o:["True","False"],a:1,e:"False — clean front to back."},
{id:"M162",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"A urinary drainage bag should remain below bladder level.",o:["True","False"],a:0,e:"True — keep the bag below the bladder."},
{id:"M163",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"Dry toast consumed by a resident is counted as fluid intake.",o:["True","False"],a:1,e:"False — dry foods are not fluid intake."},
{id:"M164",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"One fluid ounce is approximately 15 mL.",o:["True","False"],a:1,e:"False — 1 oz ≈ 30 mL."},
{id:"M165",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"Eight fluid ounces is approximately 240 mL.",o:["True","False"],a:0,e:"True — 8 oz ≈ 240 mL."},
{id:"M166",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"A nursing assistant may thin ordered thickened liquids when the resident requests regular water.",o:["True","False"],a:1,e:"False — never change ordered consistency."},
{id:"M167",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"A transfer belt should be applied directly over bare skin whenever possible.",o:["True","False"],a:1,e:"False — apply over clothing, not bare skin."},
{id:"M168",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"Wheelchair brakes should be locked before a transfer.",o:["True","False"],a:0,e:"True — lock the brakes before transferring."},
{id:"M169",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"A resident with one-sided weakness should normally hold a cane on the weak side.",o:["True","False"],a:1,e:"False — hold the cane on the strong side."},
{id:"M170",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"When dressing a resident with one-sided weakness, the weak side is generally dressed first.",o:["True","False"],a:0,e:"True — dress the weak side first."},
{id:"M171",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"Passive range-of-motion exercises are completed by the resident without assistance.",o:["True","False"],a:1,e:"False — passive ROM is done by the caregiver."},
{id:"M172",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"Active range-of-motion exercises use the resident's own muscle strength.",o:["True","False"],a:0,e:"True — active ROM uses the resident's muscles."},
{id:"M173",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"Oxygen supports combustion, so flames and sparks must be kept away.",o:["True","False"],a:0,e:"True — keep flames away from oxygen."},
{id:"M174",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"Petroleum-based products are always safe to use around oxygen equipment.",o:["True","False"],a:1,e:"False — petroleum products are a fire hazard near oxygen."},
{id:"M175",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"During a seizure, the nursing assistant should restrain the resident's arms and legs.",o:["True","False"],a:1,e:"False — never restrain during a seizure."},
{id:"M176",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"A resident found on the floor should always be lifted immediately before assessment.",o:["True","False"],a:1,e:"False — do not move the resident until assessed."},
{id:"M177",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"New chest pain or pressure should be reported immediately.",o:["True","False"],a:0,e:"True — report new chest pain immediately."},
{id:"M178",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"Delirium often has a sudden onset and may signal an urgent medical problem.",o:["True","False"],a:0,e:"True — delirium is sudden and urgent."},
{id:"M179",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"Dementia always begins suddenly over a few minutes.",o:["True","False"],a:1,e:"False — dementia develops gradually."},
{id:"M180",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"Arguing with a resident about a delusion is the best way to reduce fear.",o:["True","False"],a:1,e:"False — don't argue; acknowledge and reassure."},
{id:"M181",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"Validation and calm redirection may reduce agitation in a resident with dementia.",o:["True","False"],a:0,e:"True — validation and redirection help."},
{id:"M182",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"A restraint may be used for staff convenience when the unit is busy.",o:["True","False"],a:1,e:"False — restraints are never for convenience."},
{id:"M183",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"A do-not-resuscitate order means all food, comfort, and routine care must stop.",o:["True","False"],a:1,e:"False — DNR only stops CPR; care continues."},
{id:"M184",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"An advance directive can guide health-care decisions if a person cannot communicate.",o:["True","False"],a:0,e:"True — advance directives guide care."},
{id:"M185",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:18,q:"It is acceptable to post a resident's photograph online if the resident's name is omitted.",o:["True","False"],a:1,e:"False — never post resident photos online."},
{id:"M186",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:19,q:"Suspected abuse or neglect must be reported according to law and facility policy.",o:["True","False"],a:0,e:"True — report suspected abuse/neglect."},
{id:"M187",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:19,q:"A nursing assistant must prove that abuse occurred before reporting a suspicion.",o:["True","False"],a:1,e:"False — report suspicion; don't wait for proof."},
{id:"M188",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:19,q:"Taking a resident's money without permission is a form of financial exploitation.",o:["True","False"],a:0,e:"True — that is financial exploitation."},
{id:"M189",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:19,q:"Residents have a right to privacy during personal care.",o:["True","False"],a:0,e:"True — residents have a right to privacy."},
{id:"M190",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:19,q:"A roommate may be told a resident's diagnosis if the roommate promises secrecy.",o:["True","False"],a:1,e:"False — diagnoses are private."},
{id:"M191",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:19,q:"NPO means nothing is given by mouth unless specifically authorized.",o:["True","False"],a:0,e:"True — NPO = nothing by mouth."},
{id:"M192",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:19,q:"A resident who is NPO may still need regular oral care.",o:["True","False"],a:0,e:"True — NPO residents still need oral care."},
{id:"M193",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:19,q:"Dentures should be cleaned with very hot water to kill germs.",o:["True","False"],a:1,e:"False — hot water warps dentures."},
{id:"M194",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:19,q:"A nursing assistant should routinely cut the toenails of every resident with diabetes.",o:["True","False"],a:1,e:"False — don't cut diabetic toenails unless authorized."},
{id:"M195",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:19,q:"Persistent red, purple, or dark skin over a pressure area should be reported.",o:["True","False"],a:0,e:"True — report persistent discoloration."},
{id:"M196",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:19,q:"Shakiness, sweating, and confusion may be signs of low blood sugar.",o:["True","False"],a:0,e:"True — these can indicate low blood sugar."},
{id:"M197",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:19,q:"Cyanosis may appear as a bluish or grayish color of the lips or nail beds.",o:["True","False"],a:0,e:"True — cyanosis is bluish/grayish."},
{id:"M198",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:19,q:"A trained nursing assistant should follow the emergency plan and begin CPR when an unresponsive resident is not breathing normally.",o:["True","False"],a:0,e:"True — begin CPR per training."},
{id:"M199",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:19,q:"A nursing assistant is responsible for diagnosing the cause of a resident's sudden weakness.",o:["True","False"],a:1,e:"False — CNAs do not diagnose."},
{id:"M200",bank:"MASSIVE",type:"tf",sub:"Mixed Review (True/False)",pg:19,q:"Changes from a resident's usual condition should be observed, documented, and reported according to policy.",o:["True","False"],a:0,e:"True — observe, document, report changes."},

{id:"P1",bank:"PINK",type:"mc",sub:"Skill 1 — Handwashing",pg:2,q:"At the beginning of the handwashing skill, what communication is required?",o:["Ask the evaluator to introduce you","Address the client by name and introduce yourself by name","Begin silently","Only state the room number"],a:1,e:"Greet and introduce yourself by name."},
{id:"P2",bank:"PINK",type:"mc",sub:"Skill 1 — Handwashing",pg:2,q:"For how long must friction be produced while lathering the wrists, hands, and fingers?",o:["At least 5 seconds","At least 10 seconds","At least 20 seconds","Exactly 60 seconds"],a:2,e:"Lather with friction for at least 20 seconds."},
{id:"P3",bank:"PINK",type:"mc",sub:"Skill 1 — Handwashing",pg:2,q:"How should the hands be positioned while lathering and rinsing?",o:["Above the elbows with fingertips up","Lower than the elbows with fingertips down","At shoulder level","Pressed against the sink"],a:1,e:"Keep hands below the elbows, fingertips down."},
{id:"P4",bank:"PINK",type:"mc",sub:"Skill 1 — Handwashing",pg:2,q:"How are the fingernails cleaned during handwashing?",o:["With a sharp object","By rubbing fingertips against the opposite palms","By touching the sink","With a shared nail brush only"],a:1,e:"Rub fingertips against the opposite palm to clean nails."},
{id:"P5",bank:"PINK",type:"mc",sub:"Skill 1 — Handwashing",pg:2,q:"Which drying technique is correct?",o:["Dry from wrists toward fingertips","Dry only the palms","Dry all surfaces starting at the fingertips","Air-dry while touching the uniform"],a:2,e:"Dry from fingertips down with clean towels."},
{id:"P6",bank:"PINK",type:"mc",sub:"Skill 1 — Handwashing",pg:2,q:"How should a hand-operated faucet be turned off after washing?",o:["With bare clean hands","With a clean, dry paper towel","With the used soap wrapper","By touching it with the wrist"],a:1,e:"Turn off a hand faucet with a clean paper towel."},
{id:"P7",bank:"PINK",type:"tf",sub:"Skill 1 — Handwashing",pg:2,q:"The candidate wets both hands and wrists thoroughly before applying soap.",o:["True","False"],a:0,e:"True — wet hands and wrists before soap."},
{id:"P8",bank:"PINK",type:"tf",sub:"Skill 1 — Handwashing",pg:2,q:"Touching the inside of the sink is acceptable if the hands are rinsed afterward.",o:["True","False"],a:1,e:"False — the sink is contaminated; do not touch it."},
{id:"P9",bank:"PINK",type:"mc",sub:"Skill 2 — Knee-High Elastic Stocking",pg:3,q:"In what position should the client be while the knee-high elastic stocking is applied?",o:["Standing","Sitting with legs crossed","Supine in bed","Prone"],a:2,e:"Apply the stocking with the client supine."},
{id:"P10",bank:"PINK",type:"mc",sub:"Skill 2 — Knee-High Elastic Stocking",pg:3,q:"Before applying the stocking, the bed should be adjusted to approximately:",o:["Floor level","Waist height","Shoulder height","The highest possible position"],a:1,e:"Raise the bed to about waist height to work."},
{id:"P11",bank:"PINK",type:"mc",sub:"Skill 2 — Knee-High Elastic Stocking",pg:3,q:"How far should the stocking initially be turned inside-out?",o:["Only the top inch","At least to the heel","All the way past the toe opening","It should not be turned inside-out"],a:1,e:"Turn the stocking inside-out to the heel."},
{id:"P12",bank:"PINK",type:"mc",sub:"Skill 2 — Knee-High Elastic Stocking",pg:3,q:"Which sequence correctly begins application?",o:["Pull the stocking to the knee before covering the foot","Place the foot of the stocking over the toes, foot, and heel","Roll it around the ankle like a bandage","Apply it while the client stands"],a:1,e:"Start over the toes, foot, and heel."},
{id:"P13",bank:"PINK",type:"mc",sub:"Skill 2 — Knee-High Elastic Stocking",pg:3,q:"What is the correct final appearance of the stocking?",o:["Twisted at the ankle","Wrinkled behind the knee","Smooth, without twists or wrinkles, with the heel positioned correctly","Folded tightly at the top"],a:2,e:"Finish smooth, no wrinkles or twists, heel aligned."},
{id:"P14",bank:"PINK",type:"mc",sub:"Skill 2 — Knee-High Elastic Stocking",pg:3,q:"Which action protects the client during application?",o:["Force the ankle into position","Move the foot and leg gently and naturally","Hyperextend the knee","Pull only on the toe opening"],a:1,e:"Move the foot and leg gently and naturally."},
{id:"P15",bank:"PINK",type:"tf",sub:"Skill 2 — Knee-High Elastic Stocking",pg:3,q:"Privacy should be provided before applying the stocking.",o:["True","False"],a:0,e:"True — provide privacy first."},
{id:"P16",bank:"PINK",type:"tf",sub:"Skill 2 — Knee-High Elastic Stocking",pg:3,q:"The skill is complete even if the bed remains high and the signaling device is out of reach.",o:["True","False"],a:1,e:"False — lower the bed and place the call light in reach."},
{id:"P17",bank:"PINK",type:"mc",sub:"Skill 3 — Ambulate with Transfer Belt",pg:4,q:"What must the client wear before being assisted to stand for ambulation?",o:["Socks only","Non-skid shoes or footwear","Loose slippers without backs","No footwear"],a:1,e:"Non-skid footwear before standing."},
{id:"P18",bank:"PINK",type:"mc",sub:"Skill 3 — Ambulate with Transfer Belt",pg:4,q:"Which setup is required before the client stands?",o:["Bed unlocked and feet dangling","Bed at a safe level, wheels locked, and feet flat on the floor","Bed high and client lying flat","Transfer belt under the skin"],a:1,e:"Safe bed level, locked wheels, feet flat."},
{id:"P19",bank:"PINK",type:"mc",sub:"Skill 3 — Ambulate with Transfer Belt",pg:4,q:"Where is the transfer belt applied?",o:["Securely at the waist over clothing or a gown","Around the neck","Directly over bare skin","Around the knees"],a:0,e:"Apply the belt at the waist over clothing."},
{id:"P20",bank:"PINK",type:"mc",sub:"Skill 3 — Ambulate with Transfer Belt",pg:4,q:"Immediately before standing, the candidate should:",o:["Pull without warning","Give instructions and use a prearranged signal","Ask the client to hold the candidate's neck","Unlock the bed"],a:1,e:"Explain and use a prearranged standing signal."},
{id:"P21",bank:"PINK",type:"mc",sub:"Skill 3 — Ambulate with Transfer Belt",pg:4,q:"How should the candidate grasp the belt while helping the client stand?",o:["One hand with a downward grasp","Both sides with an upward grasp","Only the buckle","The loose end of the belt"],a:1,e:"Grasp both sides with an upward grasp."},
{id:"P22",bank:"PINK",type:"mc",sub:"Skill 3 — Ambulate with Transfer Belt",pg:4,q:"Where should the candidate walk during the required 10-foot ambulation?",o:["Several feet ahead","Slightly behind and to one side while holding the belt","Directly behind without holding the belt","On the opposite side of the hallway"],a:1,e:"Walk slightly behind and to one side, holding the belt."},
{id:"P23",bank:"PINK",type:"tf",sub:"Skill 3 — Ambulate with Transfer Belt",pg:4,q:"Knee-to-knee or toe-to-toe positioning may be used to help stabilize the client's legs during standing.",o:["True","False"],a:0,e:"True — bracing helps stabilize the legs."},
{id:"P24",bank:"PINK",type:"tf",sub:"Skill 3 — Ambulate with Transfer Belt",pg:4,q:"After ambulation, the transfer belt should remain on the client in bed.",o:["True","False"],a:1,e:"False — remove the belt after ambulation."},
{id:"P25",bank:"PINK",type:"mc",sub:"Skill 4 — Bedpan",pg:5,q:"What should be done to the head of the bed before placing the bedpan?",o:["Raise it fully","Lower it","Leave it at any position","Remove the mattress"],a:1,e:"Lower the head of the bed to place the bedpan."},
{id:"P26",bank:"PINK",type:"mc",sub:"Skill 4 — Bedpan",pg:5,q:"Which preparation is required before placing the bedpan?",o:["Put on clean gloves and adjust the bed to about waist height","Leave the bed low and use bare hands","Raise the side rail and leave the room","Put the bedpan on the floor"],a:0,e:"Glove and raise the bed to working height."},
{id:"P27",bank:"PINK",type:"mc",sub:"Skill 4 — Bedpan",pg:5,q:"After the client is positioned on the bedpan, what should happen next?",o:["Keep the gloves on while leaving","Remove gloves, wash hands, and raise the head of the bed","Lower the head of the bed further","Remove the call light"],a:1,e:"Remove gloves, wash hands, raise the head of bed."},
{id:"P28",bank:"PINK",type:"mc",sub:"Skill 4 — Bedpan",pg:5,q:"Which items must be within the client's reach while using the bedpan?",o:["Only a water pitcher","Toilet tissue, a hand wipe, and the signaling device","The clean-linen cart","A blood-pressure cuff"],a:1,e:"Tissue, hand wipe, and call light within reach."},
{id:"P29",bank:"PINK",type:"mc",sub:"Skill 4 — Bedpan",pg:5,q:"Before leaving the client on the bedpan, the bed must be:",o:["At its highest level","Unlocked","Lowered to its lowest position","Moved away from the wall"],a:2,e:"Lower the bed before leaving."},
{id:"P30",bank:"PINK",type:"mc",sub:"Skill 4 — Bedpan",pg:5,q:"Which sequence is correct when removing the bedpan?",o:["Raise the head of bed, then use bare hands","Put on clean gloves, lower the head of bed, and keep the client covered except during removal","Remove it while the client is sitting upright","Ask the client to carry it"],a:1,e:"Glove, lower head of bed, keep client covered."},
{id:"P31",bank:"PINK",type:"tf",sub:"Skill 4 — Bedpan",pg:5,q:"The bedpan is emptied and rinsed into the toilet and then placed in the designated dirty supply area.",o:["True","False"],a:0,e:"True — empty/rinse into toilet, place in dirty area."},
{id:"P32",bank:"PINK",type:"tf",sub:"Skill 4 — Bedpan",pg:5,q:"The client should remain uncovered during the entire bedpan procedure.",o:["True","False"],a:1,e:"False — keep the client covered for dignity."},
{id:"P33",bank:"PINK",type:"mc",sub:"Skill 5 — Denture Care",pg:6,q:"What must be done before handling the dentures?",o:["Put on clean gloves","Heat the dentures","Place them on a paper towel","Fill the cup with hot water"],a:0,e:"Glove before handling dentures."},
{id:"P34",bank:"PINK",type:"mc",sub:"Skill 5 — Denture Care",pg:6,q:"How should the sink be prepared before dentures are held over it?",o:["Leave it empty and hard","Line the bottom or partially fill it with water","Fill it with bleach","Cover the drain only"],a:1,e:"Line or partly fill the sink to cushion a drop."},
{id:"P35",bank:"PINK",type:"mc",sub:"Skill 5 — Denture Care",pg:6,q:"What water temperature should be used to rinse dentures?",o:["Boiling","Very hot","Moderate","Ice cold only"],a:2,e:"Use moderate-temperature water."},
{id:"P36",bank:"PINK",type:"mc",sub:"Skill 5 — Denture Care",pg:6,q:"Which cleaning action is correct?",o:["Brush only the teeth that are visible","Apply denture toothpaste and brush all surfaces","Use hand soap and skip brushing","Soak without rinsing"],a:1,e:"Brush all denture surfaces with denture paste."},
{id:"P37",bank:"PINK",type:"mc",sub:"Skill 5 — Denture Care",pg:6,q:"After cleaning, where are the dentures placed?",o:["In dry tissue","On the meal tray","In a denture cup with moderate-temperature water or solution and the lid on","Directly in the sink"],a:2,e:"Store in a covered denture cup with moderate water/solution."},
{id:"P38",bank:"PINK",type:"mc",sub:"Skill 5 — Denture Care",pg:6,q:"What should be done with the toothbrush after cleaning?",o:["Place it on the floor","Rinse it and place it in the designated basin or container","Throw it into the linen hamper","Leave it touching the dentures"],a:1,e:"Rinse and store the brush in its designated container."},
{id:"P39",bank:"PINK",type:"tf",sub:"Skill 5 — Denture Care",pg:6,q:"Clean technique must be maintained when placing the toothbrush and dentures.",o:["True","False"],a:0,e:"True — maintain clean technique."},
{id:"P40",bank:"PINK",type:"tf",sub:"Skill 5 — Denture Care",pg:6,q:"Very hot water is preferred because it cannot damage dentures.",o:["True","False"],a:1,e:"False — hot water warps dentures."},
{id:"P41",bank:"PINK",type:"mc",sub:"Skill 6 — Radial Pulse",pg:7,q:"Where are the fingertips placed to locate a radial pulse?",o:["On the little-finger side of the wrist","On the thumb side of the wrist","On the center of the palm","On the upper arm"],a:1,e:"Radial pulse is on the thumb side of the wrist."},
{id:"P42",bank:"PINK",type:"mc",sub:"Skill 6 — Radial Pulse",pg:7,q:"Which part of the candidate's hand should be used to feel the pulse?",o:["The thumb","The palm","The fingertips","The fingernails"],a:2,e:"Use the fingertips, not the thumb."},
{id:"P43",bank:"PINK",type:"mc",sub:"Skill 6 — Radial Pulse",pg:7,q:"For how long is the radial pulse counted during this skill?",o:["10 seconds","15 seconds","30 seconds","One full minute"],a:3,e:"Count the pulse for one full minute."},
{id:"P44",bank:"PINK",type:"mc",sub:"Skill 6 — Radial Pulse",pg:7,q:"When should handwashing occur in relation to recording the pulse?",o:["After recording","Before recording","Only if the pulse is irregular","It is not required"],a:1,e:"Wash hands BEFORE recording (WABON handbook, Skill 6, step 5: 'Before recording, washes hands'; step 6 records the rate)."},
{id:"P45",bank:"PINK",type:"mc",sub:"Skill 6 — Radial Pulse",pg:7,q:"The recorded pulse must be within what range of the evaluator's reading?",o:["Plus or minus 2 beats","Plus or minus 4 beats","Plus or minus 8 beats","Plus or minus 20 beats"],a:1,e:"Pulse tolerance is ±4 beats."},
{id:"P46",bank:"PINK",type:"mc",sub:"Skill 6 — Radial Pulse",pg:7,q:"What safety item must be left within the client's reach?",o:["Transfer belt","Signaling device","Soiled linen","Scale"],a:1,e:"Leave the call light (signaling device) in reach."},
{id:"P47",bank:"PINK",type:"tf",sub:"Skill 6 — Radial Pulse",pg:7,q:"The candidate explains the procedure clearly and maintains face-to-face contact whenever possible.",o:["True","False"],a:0,e:"True — explain clearly and face-to-face."},
{id:"P48",bank:"PINK",type:"tf",sub:"Skill 6 — Radial Pulse",pg:7,q:"A 30-second count is the required method for this test skill.",o:["True","False"],a:1,e:"False — count a full minute."},
{id:"P49",bank:"PINK",type:"mc",sub:"Skill 7 — Respirations",pg:8,q:"For how long are respirations counted during the test skill?",o:["15 seconds","30 seconds","45 seconds","One full minute"],a:3,e:"Count respirations for one full minute."},
{id:"P50",bank:"PINK",type:"mc",sub:"Skill 7 — Respirations",pg:8,q:"What should the candidate do before recording the respiratory rate?",o:["Wash hands","Raise the bed to shoulder height","Apply a transfer belt","Put on sterile gloves"],a:0,e:"Wash hands before recording."},
{id:"P51",bank:"PINK",type:"mc",sub:"Skill 7 — Respirations",pg:8,q:"The recorded respiratory rate must be within what range of the evaluator's reading?",o:["Plus or minus 1 breath","Plus or minus 2 breaths","Plus or minus 4 breaths","Plus or minus 8 breaths"],a:1,e:"Respiration tolerance is ±2 breaths."},
{id:"P52",bank:"PINK",type:"mc",sub:"Skill 7 — Respirations",pg:8,q:"Which item must remain within reach when the skill is finished?",o:["Signaling device","Used washcloth","Stethoscope","Bedpan"],a:0,e:"Leave the signaling device within reach."},
{id:"P53",bank:"PINK",type:"mc",sub:"Skill 7 — Respirations",pg:8,q:"How should the procedure be explained for testing purposes?",o:["Clearly, slowly, and directly","Only through a roommate","After the count is recorded","It should never be explained"],a:0,e:"Explain clearly, slowly, and directly."},
{id:"P54",bank:"PINK",type:"mc",sub:"Skill 7 — Respirations",pg:8,q:"Which observation represents one respiration?",o:["One heartbeat","One complete rise and fall of the chest or abdomen","Two coughs","One blink"],a:1,e:"One rise and fall = one respiration."},
{id:"P55",bank:"PINK",type:"tf",sub:"Skill 7 — Respirations",pg:8,q:"The official skill requires respirations to be counted for a full minute.",o:["True","False"],a:0,e:"True — count a full minute."},
{id:"P56",bank:"PINK",type:"tf",sub:"Skill 7 — Respirations",pg:8,q:"A result four breaths away from the evaluator's reading is automatically within the stated tolerance.",o:["True","False"],a:1,e:"False — tolerance is ±2, so 4 away fails."},
{id:"P57",bank:"PINK",type:"mc",sub:"Skill 8 — PPE (Gown & Gloves)",pg:9,q:"When donning the gown, which opening faces the candidate?",o:["The front opening","The back opening","The neck opening only","The sleeve opening"],a:1,e:"The gown's back opening faces the candidate."},
{id:"P58",bank:"PINK",type:"mc",sub:"Skill 8 — PPE (Gown & Gloves)",pg:9,q:"What is the correct gown-fastening sequence?",o:["Waist only","Neck, then waist so the back of clothing is covered as much as possible","Sleeves, then gloves","Waist, then remove the gown"],a:1,e:"Fasten neck, then waist to cover clothing."},
{id:"P59",bank:"PINK",type:"mc",sub:"Skill 8 — PPE (Gown & Gloves)",pg:9,q:"How should the glove cuffs be positioned?",o:["Under bare wrists","Overlapping the gown cuffs","Rolled into the palms","Below the fingertips"],a:1,e:"Glove cuffs overlap the gown cuffs."},
{id:"P60",bank:"PINK",type:"mc",sub:"Skill 8 — PPE (Gown & Gloves)",pg:9,q:"Which PPE item is removed first in this tested sequence?",o:["Gown","Gloves","Shoes","Mask"],a:1,e:"Remove gloves first."},
{id:"P61",bank:"PINK",type:"mc",sub:"Skill 8 — PPE (Gown & Gloves)",pg:9,q:"How is the first glove removed?",o:["Grasp the other glove at the palm with a gloved hand","Pull it off by the fingertips with bare teeth","Touch the wrist skin with the contaminated glove","Cut it off"],a:0,e:"Grasp the palm of the other glove with a gloved hand."},
{id:"P62",bank:"PINK",type:"mc",sub:"Skill 8 — PPE (Gown & Gloves)",pg:9,q:"After the gloves are removed, how is the gown handled?",o:["Touch the outside freely","Unfasten waist and neck, keep it away from the body and floor, and turn it inward","Drop it on the floor","Shake it before disposal"],a:1,e:"Turn the gown inward, keep it off body/floor."},
{id:"P63",bank:"PINK",type:"tf",sub:"Skill 8 — PPE (Gown & Gloves)",pg:9,q:"The gown is disposed of without contaminating the candidate, and handwashing follows the skill.",o:["True","False"],a:0,e:"True — dispose without contamination, then wash."},
{id:"P64",bank:"PINK",type:"tf",sub:"Skill 8 — PPE (Gown & Gloves)",pg:9,q:"The outside of the used gown is considered clean and may touch the uniform.",o:["True","False"],a:1,e:"False — the gown's outside is contaminated."},
{id:"P65",bank:"PINK",type:"mc",sub:"Skill 9 — Dress Affected Right Arm",pg:10,q:"Before choosing the shirt, the candidate should:",o:["Select any shirt without asking","Ask which shirt the client would like to wear","Ask the evaluator to choose","Use the soiled gown as a shirt"],a:1,e:"Let the client choose the shirt."},
{id:"P66",bank:"PINK",type:"mc",sub:"Skill 9 — Dress Affected Right Arm",pg:10,q:"How is the gown removed from a client with a right affected arm?",o:["Right affected side first","Left unaffected side first, then right affected side","Both sleeves at once","By pulling on the affected arm"],a:1,e:"Remove the unaffected side first, then the affected."},
{id:"P67",bank:"PINK",type:"mc",sub:"Skill 9 — Dress Affected Right Arm",pg:10,q:"Where is the removed gown placed?",o:["On the floor","Directly in the soiled-linen container","Back on the client","On the meal tray"],a:1,e:"Place the removed gown in the soiled-linen container."},
{id:"P68",bank:"PINK",type:"mc",sub:"Skill 9 — Dress Affected Right Arm",pg:10,q:"Which arm goes into the shirt first?",o:["Left unaffected arm","Right affected arm","Either arm","Both arms together"],a:1,e:"The affected (right) arm goes in first."},
{id:"P69",bank:"PINK",type:"mc",sub:"Skill 9 — Dress Affected Right Arm",pg:10,q:"How is overexposure prevented?",o:["Keep the client's chest covered","Leave the door open","Remove all covers","Ask another client to hold the shirt"],a:0,e:"Keep the chest covered to prevent overexposure."},
{id:"P70",bank:"PINK",type:"mc",sub:"Skill 9 — Dress Affected Right Arm",pg:10,q:"How should the affected limb be moved?",o:["Quickly and forcefully","Gently and naturally without overextension","By pulling at the wrist","Only after raising the bed rail"],a:1,e:"Move the affected limb gently, no overextension."},
{id:"P71",bank:"PINK",type:"tf",sub:"Skill 9 — Dress Affected Right Arm",pg:10,q:"The bed is adjusted to about waist height while the candidate provides care.",o:["True","False"],a:0,e:"True — raise the bed to working height."},
{id:"P72",bank:"PINK",type:"tf",sub:"Skill 9 — Dress Affected Right Arm",pg:10,q:"The skill ends with the bed high and the signaling device on the floor.",o:["True","False"],a:1,e:"False — lower the bed, call light in reach."},
{id:"P73",bank:"PINK",type:"mc",sub:"Skill 10 — Feeding",pg:11,q:"How is the correct meal tray verified?",o:["Ask the roommate","Look at the tray name card and ask the client to state their name","Use any nearby tray","Check only the room number"],a:1,e:"Match the tray name card and have the client state their name."},
{id:"P74",bank:"PINK",type:"mc",sub:"Skill 10 — Feeding",pg:11,q:"What position is required before feeding begins?",o:["Flat supine","Prone","Upright at 75-90 degrees","Side-lying at 20 degrees"],a:2,e:"Sit the client upright at 75-90 degrees."},
{id:"P75",bank:"PINK",type:"mc",sub:"Skill 10 — Feeding",pg:11,q:"What should be done before the first bite?",o:["Clean the client's hands","Lower the head of the bed","Remove all beverages","Place the tray out of view"],a:0,e:"Clean the client's hands before eating."},
{id:"P76",bank:"PINK",type:"mc",sub:"Skill 10 — Feeding",pg:11,q:"Where should the candidate be during feeding?",o:["Standing behind the client","Sitting in a chair facing the client","Across the room","Sitting on the bed"],a:1,e:"Sit facing the client while feeding."},
{id:"P77",bank:"PINK",type:"mc",sub:"Skill 10 — Feeding",pg:11,q:"Which action supports choice and communication?",o:["Mix all foods without asking","Tell the client what is on the tray and ask what they want first","Begin with the candidate's favorite food","Feed silently"],a:1,e:"Describe the food and ask the client's preference."},
{id:"P78",bank:"PINK",type:"mc",sub:"Skill 10 — Feeding",pg:11,q:"Before each next bite or sip, the candidate should:",o:["Assume the client is ready","Ask whether the client is ready","Give two bites together","Lower the client flat"],a:1,e:"Confirm the client is ready for each bite."},
{id:"P79",bank:"PINK",type:"tf",sub:"Skill 10 — Feeding",pg:11,q:"A beverage must be offered at least once during the meal.",o:["True","False"],a:0,e:"True — offer a beverage at least once."},
{id:"P80",bank:"PINK",type:"tf",sub:"Skill 10 — Feeding",pg:11,q:"At the end of the meal, the client should be left lying flat.",o:["True","False"],a:1,e:"False — keep the client upright after eating."},
{id:"P81",bank:"PINK",type:"mc",sub:"Skill 11 — Modified Bed Bath",pg:12,q:"Which body areas are included in this modified bed-bath skill?",o:["The entire body","Face and one arm, hand, and underarm","Both legs only","Back and perineal area only"],a:1,e:"Wash the face and one arm, hand, and underarm."},
{id:"P82",bank:"PINK",type:"mc",sub:"Skill 11 — Modified Bed Bath",pg:12,q:"How is the client's gown handled at the start?",o:["Placed on the floor","Placed directly in the soiled-linen container while the chest and lower body remain covered","Left under the client","Put into the clean-linen area"],a:1,e:"Put the gown in soiled linen; keep the client covered."},
{id:"P83",bank:"PINK",type:"mc",sub:"Skill 11 — Modified Bed Bath",pg:12,q:"What must happen before washing begins?",o:["Use very hot water","Check water temperature and ask the client to verify comfort","Ask the roommate to test the water","Apply lotion to the water"],a:1,e:"Check water temperature and confirm comfort."},
{id:"P84",bank:"PINK",type:"mc",sub:"Skill 11 — Modified Bed Bath",pg:12,q:"How are the eyes washed?",o:["With soap, outer to inner","Without soap, inner to outer, using a different area for each stroke","With the same soapy area for both eyes","With a dry towel only"],a:1,e:"Eyes: no soap, inner to outer, fresh area each stroke."},
{id:"P85",bank:"PINK",type:"mc",sub:"Skill 11 — Modified Bed Bath",pg:12,q:"What is placed under the exposed arm?",o:["A cloth towel","The client's gown","A bedpan","Nothing"],a:0,e:"Place a towel under the arm being washed."},
{id:"P86",bank:"PINK",type:"mc",sub:"Skill 11 — Modified Bed Bath",pg:12,q:"Which areas are washed after soap is applied to the wet washcloth?",o:["Only the elbow","Fingers including fingernails, hand, arm, and underarm","Both legs","Only the palm"],a:1,e:"Wash fingers/nails, hand, arm, and underarm."},
{id:"P87",bank:"PINK",type:"tf",sub:"Skill 11 — Modified Bed Bath",pg:12,q:"The rest of the client's body remains covered while the arm is washed.",o:["True","False"],a:0,e:"True — keep the rest covered."},
{id:"P88",bank:"PINK",type:"tf",sub:"Skill 11 — Modified Bed Bath",pg:12,q:"Used linen may touch the candidate's clothing if gloves are worn.",o:["True","False"],a:1,e:"False — never let used linen touch your uniform."},
{id:"P89",bank:"PINK",type:"mc",sub:"Skill 13 — Urinary Output",pg:13,q:"What is required before handling the bedpan?",o:["Clean gloves","Sterile gloves only","A transfer belt","No PPE"],a:0,e:"Glove before handling the bedpan."},
{id:"P90",bank:"PINK",type:"mc",sub:"Skill 13 — Urinary Output",pg:13,q:"How should urine be transferred to the measuring container?",o:["Pour without spilling or splashing outside the container","Pour it into the rinse sink","Mix it with rinse water first","Estimate without pouring"],a:0,e:"Pour carefully without spilling."},
{id:"P91",bank:"PINK",type:"mc",sub:"Skill 13 — Urinary Output",pg:13,q:"How should the measuring container be positioned for reading?",o:["Held above eye level","On a flat surface and read at eye level","Tilted toward the candidate","On the floor"],a:1,e:"Read on a flat surface at eye level."},
{id:"P92",bank:"PINK",type:"mc",sub:"Skill 13 — Urinary Output",pg:13,q:"If the urine level is between measurement lines, what should the candidate do?",o:["Round down to the nearest 10 mL","Round up to the nearest 25 mL/cc","Record an estimate in ounces only","Discard it and repeat"],a:1,e:"Round up to the nearest 25 mL/cc."},
{id:"P93",bank:"PINK",type:"mc",sub:"Skill 13 — Urinary Output",pg:13,q:"What happens to the urine after it is measured?",o:["It is stored in the room","It is emptied into the toilet","It is returned to the bedpan","It is poured into the sink"],a:1,e:"Empty measured urine into the toilet."},
{id:"P94",bank:"PINK",type:"mc",sub:"Skill 13 — Urinary Output",pg:13,q:"How close must the recorded amount be to the evaluator's reading?",o:["Plus or minus 5 mL","Plus or minus 10 mL","Plus or minus 25 mL/cc","Plus or minus 100 mL"],a:2,e:"Urine output tolerance is ±25 mL/cc."},
{id:"P95",bank:"PINK",type:"tf",sub:"Skill 13 — Urinary Output",pg:13,q:"The measuring container is rinsed, and the rinse is poured into the toilet.",o:["True","False"],a:0,e:"True — rinse into the toilet."},
{id:"P96",bank:"PINK",type:"tf",sub:"Skill 13 — Urinary Output",pg:13,q:"The amount should be recorded before gloves are removed and hands are washed.",o:["True","False"],a:1,e:"False — remove gloves and wash hands before recording."},
{id:"P97",bank:"PINK",type:"mc",sub:"Skill 14 — Ambulatory Weight",pg:14,q:"What footwear is required before the client walks to the scale?",o:["Bare feet","Non-skid shoes or footwear","Loose socks only","High heels"],a:1,e:"Non-skid footwear before walking to the scale."},
{id:"P98",bank:"PINK",type:"mc",sub:"Skill 14 — Ambulatory Weight",pg:14,q:"What must the candidate do to the scale before the client steps on it?",o:["Set it to zero","Add two pounds","Cover the indicator","Move it while the client stands"],a:0,e:"Zero the scale before the client steps on."},
{id:"P99",bank:"PINK",type:"mc",sub:"Skill 14 — Ambulatory Weight",pg:14,q:"Where should the client stand on the scale?",o:["On one edge","In the center","With one foot off","Facing away from the scale"],a:1,e:"Stand centered on the scale."},
{id:"P100",bank:"PINK",type:"mc",sub:"Skill 14 — Ambulatory Weight",pg:14,q:"What should the candidate do after obtaining the weight?",o:["Leave the client on the scale","Ask the client to step off","Record before helping the client","Reset the scale while occupied"],a:1,e:"Help the client step off after weighing."},
{id:"P101",bank:"PINK",type:"mc",sub:"Skill 14 — Ambulatory Weight",pg:14,q:"When should the candidate wash hands?",o:["Before recording the weight","Only if the scale is dirty","After leaving the test area","It is not required"],a:0,e:"Wash hands before recording."},
{id:"P102",bank:"PINK",type:"mc",sub:"Skill 14 — Ambulatory Weight",pg:14,q:"What is the accepted tolerance when weight is recorded in pounds?",o:["Plus or minus 1 pound","Plus or minus 2 pounds","Plus or minus 5 pounds","Plus or minus 10 pounds"],a:1,e:"Weight tolerance is ±2 pounds."},
{id:"P103",bank:"PINK",type:"tf",sub:"Skill 14 — Ambulatory Weight",pg:14,q:"If weight is recorded in kilograms, it must be within plus or minus 0.9 kg of the evaluator's reading.",o:["True","False"],a:0,e:"True — ±0.9 kg tolerance."},
{id:"P104",bank:"PINK",type:"tf",sub:"Skill 14 — Ambulatory Weight",pg:14,q:"The client should step onto the scale before it is set to zero.",o:["True","False"],a:1,e:"False — zero the scale first."},
{id:"P105",bank:"PINK",type:"mc",sub:"Skill 15 — PROM Knee & Ankle",pg:15,q:"What position is required for the client during this PROM skill?",o:["Standing","Supine in bed","Prone","Sitting on a scale"],a:1,e:"Client is supine for knee/ankle PROM."},
{id:"P106",bank:"PINK",type:"mc",sub:"Skill 15 — PROM Knee & Ankle",pg:15,q:"Before beginning movement, the client should be instructed to:",o:["Remain silent if pain occurs","Tell the candidate if pain occurs","Move the leg independently","Hold the bed rail with both hands"],a:1,e:"Tell the client to report any pain."},
{id:"P107",bank:"PINK",type:"mc",sub:"Skill 15 — PROM Knee & Ankle",pg:15,q:"Where is the leg supported during knee flexion and extension?",o:["At the toes only","At the knee and ankle","At the hip only","Behind the neck"],a:1,e:"Support at both the knee and ankle."},
{id:"P108",bank:"PINK",type:"mc",sub:"Skill 15 — PROM Knee & Ankle",pg:15,q:"How many times is knee flexion and extension performed unless pain is verbalized?",o:["Once","Twice","At least three times","Ten times"],a:2,e:"Perform at least three times."},
{id:"P109",bank:"PINK",type:"mc",sub:"Skill 15 — PROM Knee & Ankle",pg:15,q:"Which ankle movements are performed?",o:["Inversion and eversion only","Dorsiflexion toward the head and plantar flexion with toes down","Rotation in complete circles","No ankle movement"],a:1,e:"Dorsiflexion and plantar flexion of the ankle."},
{id:"P110",bank:"PINK",type:"mc",sub:"Skill 15 — PROM Knee & Ankle",pg:15,q:"How should all PROM movements be performed?",o:["Quickly and forcefully","Gently, slowly, and smoothly","Until the joint resists sharply","Without supporting the limb"],a:1,e:"Move gently, slowly, and smoothly."},
{id:"P111",bank:"PINK",type:"tf",sub:"Skill 15 — PROM Knee & Ankle",pg:15,q:"The movement is stopped if the client verbalizes pain.",o:["True","False"],a:0,e:"True — stop for pain."},
{id:"P112",bank:"PINK",type:"tf",sub:"Skill 15 — PROM Knee & Ankle",pg:15,q:"The foot and ankle should be lifted far away from the bed during ankle PROM.",o:["True","False"],a:1,e:"False — support near the bed; don't lift far away."},
{id:"P113",bank:"PINK",type:"mc",sub:"Skill 16 — PROM Shoulder",pg:16,q:"What should the candidate tell the client before beginning shoulder PROM?",o:["Pain is expected","Report any pain during the exercise","Move the arm without help","Hold the breath"],a:1,e:"Tell the client to report any pain."},
{id:"P114",bank:"PINK",type:"mc",sub:"Skill 16 — PROM Shoulder",pg:16,q:"Where should the arm be supported?",o:["At the fingers only","At the elbow and wrist","At the shoulder only","At the neck"],a:1,e:"Support the arm at the elbow and wrist."},
{id:"P115",bank:"PINK",type:"mc",sub:"Skill 16 — PROM Shoulder",pg:16,q:"During shoulder flexion and extension, the straightened arm is raised:",o:["Toward the head to ear level, then returned to the side","Only to waist level","Behind the back","Across the chest only"],a:0,e:"Raise the arm toward the head to ear level and back."},
{id:"P116",bank:"PINK",type:"mc",sub:"Skill 16 — PROM Shoulder",pg:16,q:"During abduction and adduction, the straightened arm is moved:",o:["Away from the body to shoulder level and back","Past the head with force","Only at the elbow","Toward the feet"],a:0,e:"Move the arm out to shoulder level and back."},
{id:"P117",bank:"PINK",type:"mc",sub:"Skill 16 — PROM Shoulder",pg:16,q:"How many times is each tested shoulder movement completed unless pain occurs?",o:["One time","Two times","At least three times","Twenty times"],a:2,e:"At least three times each."},
{id:"P118",bank:"PINK",type:"mc",sub:"Skill 16 — PROM Shoulder",pg:16,q:"What is the proper response if the client reports pain?",o:["Continue more slowly","Stop the movement","Force the joint farther","Ask the client to ignore it"],a:1,e:"Stop the movement if the client reports pain."},
{id:"P119",bank:"PINK",type:"tf",sub:"Skill 16 — PROM Shoulder",pg:16,q:"Shoulder PROM is performed gently, slowly, and smoothly.",o:["True","False"],a:0,e:"True — gently, slowly, smoothly."},
{id:"P120",bank:"PINK",type:"tf",sub:"Skill 16 — PROM Shoulder",pg:16,q:"The bed may remain at waist height after the skill is finished.",o:["True","False"],a:1,e:"False — lower the bed when finished."},
{id:"P121",bank:"PINK",type:"mc",sub:"Skill 17 — Position on Side",pg:17,q:"What should be done to the head of the bed before turning the client?",o:["Raise it fully","Lower it","Remove it","Leave it unchanged in every situation"],a:1,e:"Lower the head of the bed before turning."},
{id:"P122",bank:"PINK",type:"mc",sub:"Skill 17 — Position on Side",pg:17,q:"Which side rail is raised before the client is turned?",o:["The side away from the turn","The side toward which the body will be turned","Both rails in every case","Neither rail"],a:1,e:"Raise the rail on the side the client turns toward."},
{id:"P123",bank:"PINK",type:"mc",sub:"Skill 17 — Position on Side",pg:17,q:"How should the client be moved?",o:["Pulled quickly by the arm","Assisted to roll slowly toward the raised side rail","Rolled toward the open edge","Lifted by the neck"],a:1,e:"Assist the client to roll slowly toward the raised rail."},
{id:"P124",bank:"PINK",type:"mc",sub:"Skill 17 — Position on Side",pg:17,q:"After turning, what is adjusted under the client's head?",o:["A bedpan","A pillow for support","A transfer belt","A folded gown"],a:1,e:"Support the head with a pillow."},
{id:"P125",bank:"PINK",type:"mc",sub:"Skill 17 — Position on Side",pg:17,q:"What must be done with the lower arm and shoulder?",o:["Leave the client lying on the arm","Reposition them so the client is not lying on the arm","Place the arm under the hip","Tie the arm to the rail"],a:1,e:"Free the lower arm so the client isn't lying on it."},
{id:"P126",bank:"PINK",type:"mc",sub:"Skill 17 — Position on Side",pg:17,q:"Which support arrangement is correct?",o:["No supports are needed","Support the top arm, place support behind the back, and support the flexed top knee and ankle between the legs","Place all pillows under the lower leg","Keep both legs straight without support"],a:1,e:"Support top arm, back, and the flexed top knee and ankle."},
{id:"P127",bank:"PINK",type:"tf",sub:"Skill 17 — Position on Side",pg:17,q:"Privacy is provided before positioning the client.",o:["True","False"],a:0,e:"True — provide privacy first."},
{id:"P128",bank:"PINK",type:"tf",sub:"Skill 17 — Position on Side",pg:17,q:"The skill is complete with the bed high and the call light out of reach.",o:["True","False"],a:1,e:"False — lower the bed, call light in reach."},
{id:"P129",bank:"PINK",type:"mc",sub:"Skill 18 — Catheter Care (Female)",pg:18,q:"What must be done before washing begins?",o:["Check the water temperature and ask the client to verify comfort","Use the hottest water available","Disconnect the catheter","Raise the drainage bag"],a:0,e:"Check water temperature and confirm comfort."},
{id:"P130",bank:"PINK",type:"mc",sub:"Skill 18 — Catheter Care (Female)",pg:18,q:"Where is the linen protector placed?",o:["Under the client's head","Under the perineal area, including the buttocks","Across the chest","Under the drainage bag only"],a:1,e:"Place the protector under the perineal area/buttocks."},
{id:"P131",bank:"PINK",type:"mc",sub:"Skill 18 — Catheter Care (Female)",pg:18,q:"How much of the client should be exposed?",o:["The entire lower body","Only the area between the hip and knee surrounding the catheter","Only the feet","The chest and abdomen"],a:1,e:"Expose only the hip-to-knee catheter area."},
{id:"P132",bank:"PINK",type:"mc",sub:"Skill 18 — Catheter Care (Female)",pg:18,q:"How should the catheter be held during cleaning?",o:["Pulled away from the body","Held at the meatus without tugging","Disconnected from the tubing","Held by the drainage bag"],a:1,e:"Stabilize at the meatus without tugging."},
{id:"P133",bank:"PINK",type:"mc",sub:"Skill 18 — Catheter Care (Female)",pg:18,q:"In what direction is at least four inches of catheter cleaned?",o:["Toward the meatus","Away from the meatus in one direction","Back and forth with one area of cloth","In circular motions"],a:1,e:"Clean ≥4 inches away from the meatus, one direction."},
{id:"P134",bank:"PINK",type:"mc",sub:"Skill 18 — Catheter Care (Female)",pg:18,q:"What technique is used for each cleaning and rinsing stroke?",o:["Reuse the same soiled area","Use a clean area of the washcloth for each stroke","Use a dry towel only","Apply powder after every stroke"],a:1,e:"Use a clean cloth area for each stroke."},
{id:"P135",bank:"PINK",type:"tf",sub:"Skill 18 — Catheter Care (Female)",pg:18,q:"The catheter is dried for at least four inches moving away from the meatus.",o:["True","False"],a:0,e:"True — dry ≥4 inches away from the meatus."},
{id:"P136",bank:"PINK",type:"tf",sub:"Skill 18 — Catheter Care (Female)",pg:18,q:"Used linens may touch the candidate's uniform as long as gloves are worn.",o:["True","False"],a:1,e:"False — never let used linen touch your uniform."},
{id:"P137",bank:"PINK",type:"mc",sub:"Skill 19 — Foot Care",pg:19,q:"What should happen before the client's foot is placed into the water?",o:["Check water temperature and ask the client to verify comfort","Add bleach","Cut the toenails","Apply lotion between the toes"],a:0,e:"Check water temperature and confirm comfort."},
{id:"P138",bank:"PINK",type:"mc",sub:"Skill 19 — Foot Care",pg:19,q:"How should the basin be positioned?",o:["On the floor without protection","Comfortably for the client and on a protective barrier","On the client's abdomen","Out of the client's reach"],a:1,e:"Place the basin comfortably on a protective barrier."},
{id:"P139",bank:"PINK",type:"mc",sub:"Skill 19 — Foot Care",pg:19,q:"Which areas must be washed and rinsed?",o:["The top of the foot only","The entire foot, including between the toes","The ankle only","The toenails only"],a:1,e:"Wash the entire foot, including between the toes."},
{id:"P140",bank:"PINK",type:"mc",sub:"Skill 19 — Foot Care",pg:19,q:"Which area requires careful drying?",o:["Between the toes","Only the heel","Only the ankle","The basin"],a:0,e:"Dry carefully between the toes."},
{id:"P141",bank:"PINK",type:"mc",sub:"Skill 19 — Foot Care",pg:19,q:"Where is lotion applied?",o:["Between the toes only","To the top and bottom of the foot, excluding between the toes","Only under the toenails","Nowhere on the foot"],a:1,e:"Apply lotion to the foot but not between the toes."},
{id:"P142",bank:"PINK",type:"mc",sub:"Skill 19 — Foot Care",pg:19,q:"How is the limb protected throughout care?",o:["The foot and ankle are supported","The leg is allowed to hang","The ankle is forced into flexion","The client holds the foot alone"],a:0,e:"Support the foot and ankle throughout."},
{id:"P143",bank:"PINK",type:"tf",sub:"Skill 19 — Foot Care",pg:19,q:"Excess lotion should be removed with a towel or washcloth.",o:["True","False"],a:0,e:"True — remove excess lotion."},
{id:"P144",bank:"PINK",type:"tf",sub:"Skill 19 — Foot Care",pg:19,q:"The skill is complete without emptying, rinsing, and drying the basin.",o:["True","False"],a:1,e:"False — empty, rinse, and dry the basin."},
{id:"P145",bank:"PINK",type:"mc",sub:"Skill 20 — Mouth Care",pg:20,q:"What position is required before mouth care begins?",o:["Flat on the back","Upright at 75-90 degrees","Prone","Trendelenburg"],a:1,e:"Sit the client upright at 75-90 degrees."},
{id:"P146",bank:"PINK",type:"mc",sub:"Skill 20 — Mouth Care",pg:20,q:"If the client sits on the side of the bed, how should the bed be adjusted?",o:["So the feet are flat on the floor","So the feet dangle","To the highest position","With wheels unlocked"],a:0,e:"Adjust so the feet are flat on the floor."},
{id:"P147",bank:"PINK",type:"mc",sub:"Skill 20 — Mouth Care",pg:20,q:"What protective item is placed across the client's chest?",o:["A cloth towel","A transfer belt","A bedpan","A gown turned inside-out"],a:0,e:"Place a towel across the chest."},
{id:"P148",bank:"PINK",type:"mc",sub:"Skill 20 — Mouth Care",pg:20,q:"What happens immediately before toothpaste is applied?",o:["The toothbrush is moistened with water","The client is placed flat","The basin is removed","The gloves are discarded"],a:0,e:"Moisten the toothbrush before applying toothpaste."},
{id:"P149",bank:"PINK",type:"mc",sub:"Skill 20 — Mouth Care",pg:20,q:"What areas are cleaned?",o:["Front teeth only","Tongue and all surfaces of the teeth using gentle motions","Lips only","Dentures only"],a:1,e:"Clean the tongue and all tooth surfaces gently."},
{id:"P150",bank:"PINK",type:"mc",sub:"Skill 20 — Mouth Care",pg:20,q:"Where is the emesis basin held while the client rinses?",o:["At the client's chin","On the floor","Behind the client's head","At the foot of the bed"],a:0,e:"Hold the emesis basin at the chin."},
{id:"P151",bank:"PINK",type:"tf",sub:"Skill 20 — Mouth Care",pg:20,q:"Clean technique must be maintained when placing the toothbrush.",o:["True","False"],a:0,e:"True — maintain clean technique."},
{id:"P152",bank:"PINK",type:"tf",sub:"Skill 20 — Mouth Care",pg:20,q:"The clothing protector should remain on the client after care is finished.",o:["True","False"],a:1,e:"False — remove the protector when finished."},
{id:"P153",bank:"PINK",type:"mc",sub:"Skill 21 — Perineal Care (Female)",pg:21,q:"Where is the linen protector placed before washing?",o:["Under the perineal area, including the buttocks","Under the client's head","Across the chest","On the floor"],a:0,e:"Place the protector under the perineal area/buttocks."},
{id:"P154",bank:"PINK",type:"mc",sub:"Skill 21 — Perineal Care (Female)",pg:21,q:"How much of the client is exposed?",o:["The entire body","Only between the hips and knees","Only the upper body","The room door remains open"],a:1,e:"Expose only between the hips and knees."},
{id:"P155",bank:"PINK",type:"mc",sub:"Skill 21 — Perineal Care (Female)",pg:21,q:"In what direction is the genital area washed?",o:["Back to front","Front to back","Side to side with one cloth area","In repeated circles"],a:1,e:"Wash the genital area front to back."},
{id:"P156",bank:"PINK",type:"mc",sub:"Skill 21 — Perineal Care (Female)",pg:21,q:"What washcloth technique is required?",o:["Use the same area for every stroke","Use a clean area for each stroke","Use only a dry cloth","Share the cloth with another client"],a:1,e:"Use a clean cloth area for each stroke."},
{id:"P157",bank:"PINK",type:"mc",sub:"Skill 21 — Perineal Care (Female)",pg:21,q:"How is the rectal area washed after the client is turned to the side?",o:["Back to front","Front to back using a clean area for each stroke","With lotion only","Without rinsing"],a:1,e:"Wash the rectal area front to back, clean area each stroke."},
{id:"P158",bank:"PINK",type:"mc",sub:"Skill 21 — Perineal Care (Female)",pg:21,q:"Which sequence is correct for both genital and rectal areas?",o:["Dry, soap, then rinse","Wash, rinse, and dry from front to back","Rinse only","Wash back to front and air-dry"],a:1,e:"Wash, rinse, dry front to back."},
{id:"P159",bank:"PINK",type:"tf",sub:"Skill 21 — Perineal Care (Female)",pg:21,q:"The client is repositioned after the rectal area is cleaned and dried.",o:["True","False"],a:0,e:"True — reposition the client afterward."},
{id:"P160",bank:"PINK",type:"tf",sub:"Skill 21 — Perineal Care (Female)",pg:21,q:"Perineal care may be performed without privacy if the client is covered afterward.",o:["True","False"],a:1,e:"False — privacy is required."},
{id:"P161",bank:"PINK",type:"mc",sub:"Skill 22 — Bed to Wheelchair Transfer",pg:22,q:"Where is the wheelchair positioned before the client stands?",o:["Across the room","Alongside the bed in an approved head-to-foot or foot-to-head orientation","Directly behind the bed","In the hallway"],a:1,e:"Position the wheelchair alongside the bed."},
{id:"P162",bank:"PINK",type:"mc",sub:"Skill 22 — Bed to Wheelchair Transfer",pg:22,q:"Which wheels must be locked before standing?",o:["Wheelchair wheels only","Bed wheels only","Both wheelchair and bed wheels","No wheels"],a:2,e:"Lock both the wheelchair and bed wheels."},
{id:"P163",bank:"PINK",type:"mc",sub:"Skill 22 — Bed to Wheelchair Transfer",pg:22,q:"Which client setup is required before standing?",o:["Lying flat with bare feet","Sitting with feet flat on the floor and wearing shoes","Sitting with feet on wheelchair footrests","Standing without a belt"],a:1,e:"Sit with feet flat and shoes on before standing."},
{id:"P164",bank:"PINK",type:"mc",sub:"Skill 22 — Bed to Wheelchair Transfer",pg:22,q:"How is the transfer belt used?",o:["Applied over clothing at the waist and grasped on both sides with an upward grasp","Applied around the chest","Applied under bare skin","Held only by the buckle"],a:0,e:"Apply over clothing at the waist; grasp both sides upward."},
{id:"P165",bank:"PINK",type:"mc",sub:"Skill 22 — Bed to Wheelchair Transfer",pg:22,q:"What must happen before the candidate assists the client to stand?",o:["A prearranged signal is explained and used","The wheelchair is unlocked","The footrests remain in front of the client's feet","The client pulls on the candidate's neck"],a:0,e:"Explain and use a prearranged standing signal."},
{id:"P166",bank:"PINK",type:"mc",sub:"Skill 22 — Bed to Wheelchair Transfer",pg:22,q:"When is the client ready to be lowered into the wheelchair?",o:["When the back of the client's legs touches the wheelchair","Immediately after standing","Before turning","While the wheelchair is moving"],a:0,e:"Lower when the backs of the legs touch the chair."},
{id:"P167",bank:"PINK",type:"tf",sub:"Skill 22 — Bed to Wheelchair Transfer",pg:22,q:"After lowering, the client's hips are positioned against the back of the wheelchair and the feet are placed on the footrests.",o:["True","False"],a:0,e:"True — hips back, feet on footrests."},
{id:"P168",bank:"PINK",type:"tf",sub:"Skill 22 — Bed to Wheelchair Transfer",pg:22,q:"The transfer belt should remain on after the client is positioned in the wheelchair.",o:["True","False"],a:1,e:"False — remove the belt after positioning."},
{id:"P169",bank:"PINK",type:"mc",sub:"Skill 23 — Manual Blood Pressure",pg:23,q:"What parts of the stethoscope are cleaned before use?",o:["Tubing only","Bell or diaphragm and earpieces","Cuff only","Gauge only"],a:1,e:"Clean the bell/diaphragm and earpieces."},
{id:"P170",bank:"PINK",type:"mc",sub:"Skill 23 — Manual Blood Pressure",pg:23,q:"How is the client's arm positioned?",o:["Palm down with clothing covering the arm","Palm up with the upper arm exposed","Behind the back","Hanging unsupported"],a:1,e:"Position the arm palm-up with the upper arm exposed."},
{id:"P171",bank:"PINK",type:"mc",sub:"Skill 23 — Manual Blood Pressure",pg:23,q:"If the client is sitting, what lower-body position is required?",o:["Legs crossed and feet dangling","Legs uncrossed with feet flat on the floor","Both feet on the bed","One leg elevated"],a:1,e:"Legs uncrossed, feet flat on the floor."},
{id:"P172",bank:"PINK",type:"mc",sub:"Skill 23 — Manual Blood Pressure",pg:23,q:"Where is the cuff sensor or arrow placed?",o:["Over the radial artery","Over the brachial artery site","Over the wrist","Over clothing at the shoulder"],a:1,e:"Place the cuff marker over the brachial artery."},
{id:"P173",bank:"PINK",type:"mc",sub:"Skill 23 — Manual Blood Pressure",pg:23,q:"To what range is the cuff initially inflated?",o:["80-100 mm Hg","120-140 mm Hg","160-180 mm Hg","220-240 mm Hg"],a:2,e:"Inflate to 160-180 mm Hg."},
{id:"P174",bank:"PINK",type:"mc",sub:"Skill 23 — Manual Blood Pressure",pg:23,q:"What do the first and last sounds represent during slow deflation?",o:["First is diastolic and last is pulse","First is systolic and last is diastolic","Both are systolic","Both are respiratory sounds"],a:1,e:"First sound = systolic, last sound = diastolic."},
{id:"P175",bank:"PINK",type:"tf",sub:"Skill 23 — Manual Blood Pressure",pg:23,q:"If rounding is needed, the blood-pressure measurements are rounded up to the nearest 2 mm Hg.",o:["True","False"],a:0,e:"True — round up to the nearest 2 mm Hg."},
{id:"P176",bank:"PINK",type:"tf",sub:"Skill 23 — Manual Blood Pressure",pg:23,q:"Each recorded pressure may be more than 8 mm Hg away from the evaluator's reading and still meet the stated tolerance.",o:["True","False"],a:1,e:"False — tolerance is ±8 mm Hg."}
]
